{
  "brand": "Agent Customs",
  "networks": [
    {
      "name": "agent_customs",
      "front_man": "customs_officer",
      "hocon": "./agent_customs.network.json",
      "description": "Border control for the Open Agentic Web: inspect any agent network before it runs in your browser.",
      "tags": [
        "agentified-website",
        "trust-and-safety",
        "conformance"
      ],
      "sample_queries": [
        "Inspect https://agent-customs-range.github.io/shady_pizza/shady_pizza and explain the verdict in plain words.",
        "What does the Sunny Bakery test network offer? Ask it.",
        "Compare https://agent-customs-range.github.io/sunny_bakery/sunny_bakery with https://agent-customs-range.github.io/rugpull/sunny_bakery.",
        "Inspect https://agent-customs-range.github.io/bank_helper/bank_helper and tell me what the publisher should fix.",
        "Can you certify my network as safe for everyone?"
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [
    "https://agent-customs-range.github.io"
  ],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Calls only the test-range partner sites in allowed_peers, after the visitor agrees, and only once Agent Customs has inspected them in the visitor's browser."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "agent_customs",
    "front_man": "customs_officer",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#0c1d18"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "agent_customs",
        "front_man": "customs_officer",
        "aliases": [
          "agent_customs",
          "customs_officer"
        ],
        "url": "agent_customs"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "bridge": "./bridge/action-bridge.html",
    "agentTools": [
      "get_desk_state",
      "inspect_agent_network",
      "get_inspection_details",
      "compare_networks",
      "pin_network",
      "unpin_network"
    ]
  }
}
