{
  "brand": "Main Street Guide",
  "networks": [
    {
      "name": "main_street_guide",
      "front_man": "main_street_assistant",
      "hocon": "./main_street_guide.network.json",
      "description": "Asks the assistants of the shops on Main Street what they offer, and gives each shop's page.",
      "tags": [
        "agentified-website",
        "agent-customs-practice"
      ],
      "sample_queries": [
        "Which shops are on Main Street?",
        "Ask Sunny Bakery what it offers.",
        "Ask Shady Pizza what it offers.",
        "Ask Loop Maze for a puzzle.",
        "Book a table for two at Shady Pizza tonight."
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [
    "https://agent-customs-range.github.io"
  ],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Calls the partner shops in allowed_peers after the visitor agrees. The Agent Customs guard inspects each one in the visitor's browser before it runs."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "main_street_guide",
    "front_man": "main_street_assistant",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#0a1430"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "main_street_guide",
        "front_man": "main_street_assistant",
        "aliases": [
          "main_street_guide",
          "main_street_assistant"
        ],
        "url": "main_street_guide"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "bridge": "./bridge/action-bridge.html",
    "agentTools": [
      "list_shops"
    ]
  }
}
