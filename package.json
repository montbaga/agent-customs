{
  "name": "agent-customs",
  "version": "1.2.0",
  "description": "Border control for the Open Agentic Web: inspect any agent network before it runs in your browser.",
  "license": "Apache-2.0",
  "author": "Monty Bagati (https://github.com/montbaga)",
  "homepage": "https://montbaga.github.io/agent-customs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montbaga/agent-customs.git"
  },
  "bugs": {
    "url": "https://github.com/montbaga/agent-customs/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-security",
    "mcp",
    "model-context-protocol",
    "a2a",
    "prompt-injection",
    "open-agentic-web",
    "llm-security"
  ],
  "type": "module",
  "exports": {
    ".": "./site/customs/guard.js",
    "./auto": "./site/customs/auto.js",
    "./inspect": "./site/customs/inspect.js",
    "./customs/*": "./site/customs/*"
  },
  "bin": {
    "agent-customs": "bin/agent-customs.mjs"
  },
  "files": [
    "site/customs/",
    "site/runtime/hocon.js",
    "site/runtime/kernel.js",
    "site/runtime/model.js",
    "site/runtime/generated/graph.gen.mjs",
    "site/runtime/generated/validation.gen.mjs",
    "site/runtime/LICENSE.txt",
    "site/arena.js",
    "site/bench.json",
    "site/certificate.js",
    "site/desk.js",
    "site/providers.js",
    "site/receipts/",
    "site/samples/",
    "site/.well-known/agent-customs-key.json",
    "bin/",
    "tools/bench.mjs",
    "tools/external-heldout.mjs",
    "tools/fs-fetch.mjs",
    "tools/heldout-corpus.mjs",
    "tools/inspect-local.mjs",
    "tools/mcp-server.mjs",
    "tools/round2-corpus.mjs",
    "tools/round3-corpus.mjs",
    "tests/fixtures/official/",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node vendor/agentify-website/scripts/build_network.mjs site/agent_customs.hocon --manifest site/agent-manifest.json",
    "check": "node vendor/agentify-website/scripts/build_network.mjs site/agent_customs.hocon --manifest site/agent-manifest.json --check",
    "range": "node tools/make-range.mjs",
    "practice": "node tools/make-practice.mjs",
    "extension": "node tools/make-extension.mjs",
    "bundle": "node tools/make-bundle.mjs",
    "vault": "node tools/make-vault.mjs",
    "check:practice": "node vendor/agentify-website/scripts/build_network.mjs practice/main_street_guide.hocon --manifest practice/agent-manifest.json --check",
    "test": "node --test \"tests/*.test.mjs\"",
    "bench": "node tools/bench.mjs",
    "serve": "node tools/serve.mjs site --port 8080",
    "serve:vault": "node tools/serve.mjs vault --port 8090",
    "serve:range": "node tools/serve.mjs range --port 8081 --log range-requests.jsonl",
    "serve:practice": "node tools/serve.mjs practice --port 8082",
    "smoke": "node tools/smoke.mjs --out screenshots",
    "vault:check": "node tools/vault-check.mjs",
    "shots": "node tools/readme-shots.mjs",
    "inspect": "node tools/inspect-local.mjs",
    "mcp": "node tools/mcp-server.mjs",
    "receipts": "node tools/receipts.mjs"
  }
}
