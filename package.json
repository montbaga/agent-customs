{
  "name": "agent-customs",
  "version": "1.0.0",
  "description": "Border control for the Open Agentic Web: inspect any agent network before it runs in your browser.",
  "license": "Apache-2.0",
  "author": "Monty Bagati (https://github.com/montbaga)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node vendor/agentify-website/scripts/build_network.mjs site/agent_customs.hocon --manifest site/agent-manifest.json",
    "check": "node vendor/agentify-website/scripts/build_network.mjs site/agent_customs.hocon --manifest site/agent-manifest.json --check",
    "range": "node tools/make-range.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "serve": "node tools/serve.mjs site --port 8080",
    "serve:range": "node tools/serve.mjs range --port 8081 --log range-requests.jsonl",
    "smoke": "node tools/smoke.mjs --out screenshots",
    "inspect": "node tools/inspect-local.mjs"
  }
}
