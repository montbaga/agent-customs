   {
    "name": "create_scoreboard",
    "title": "Create a scoreboard",
    "description": "Create a public, shareable two-team scoreboard at zero. Requires explicit user intent to create; title and team names are public. Works without signing in: the result then includes a private claim.url (valid up to seven days) for the person who will keep score; it lets them score in the browser and keep the board. Share links.spectator with viewers. A board made without a connection cannot be updated by later tool calls; connect an account first if you need to keep score. Free boards allow 50 total spectator views and show branding. With a connection, retry the identical requestId and input after a timeout; without one, a retry creates another board.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "requestId": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_-]{8,128}$"
      },
      "title": {
       "type": "string",
       "minLength": 1,
       "maxLength": 100
      },
      "teams": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "items": [
        {
         "type": "object",
         "properties": {
          "name": {
           "$ref": "#/properties/title"
          }
         },
         "required": [
          "name"
         ],
         "additionalProperties": false
        },
        {
         "type": "object",
         "properties": {
          "name": {
           "$ref": "#/properties/title"
          }
         },
         "required": [
          "name"
         ],
         "additionalProperties": false
        }
       ]
      }
     },
     "required": [
      "requestId",
      "title",
      "teams"
     ],
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": true
    },
    "execution": {
     "taskSupport": "forbidden"
    },
    "_meta": {
     "securitySchemes": [
      {
       "type": "noauth"
      },
      {
       "type": "oauth2",
       "scopes": [
        "scoreboards:write"
       ]
      }
     ]
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "teams": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "score": {
          "type": "number"
         }
        },
        "required": [
         "id",
         "name",
         "score"
        ],
        "additionalProperties": false
       }
      },
      "revision": {
       "type": "string"
      },
      "links": {
       "type": "object",
       "properties": {
        "spectator": {
         "type": "string"
        },
        "manage": {
         "type": [
          "string",
          "null"
         ]
        },
        "overlay": {
         "type": "string"
        }
       },
       "required": [
        "spectator",
        "manage",
        "overlay"
       ],
       "additionalProperties": false
      },
      "limits": {
       "type": "object",
       "properties": {
        "spectatorViews": {
         "type": [
          "number",
          "null"
         ]
        },
        "watermark": {
         "type": "boolean"
        }
       },
       "required": [
        "spectatorViews",
        "watermark"
       ],
       "additionalProperties": false
