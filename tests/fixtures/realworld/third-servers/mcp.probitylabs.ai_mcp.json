{
 "url": "https://mcp.probitylabs.ai/mcp",
 "doc": {
  "name": "Probity Wallet Reputation",
  "version": "1.1.0",
  "protocolVersion": "2025-06-18",
  "instructions": "All Probity tools require an authenticated session. If you are not signed in, your MCP client will prompt you to authenticate via OAuth; calls made without a valid session are rejected. Tool discovery (tools/list) is available without signing in.",
  "tools": [
   {
    "name": "screen_address",
    "title": "Screen address",
    "description": "Screen an Ethereum address or `.eth` ENS name for on-chain reputation risk. Costs 1 credit. Returns a signed reputation score (-100 to +100), a risk band, a confidence level, a sanctioned flag, the top evidence factors, a screeningId, and a link to the full report. The enhanced review is generated in the background. Fetch it with get_screening_narrative(screeningId). Use the score, band, and sanctioned flag to gate pre-trade or payout flows.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "address": {
       "type": "string",
       "description": "Ethereum address (0x...) or `.eth` ENS name (e.g. vitalik.eth) to screen. ENS names resolve to their current mainnet address and must resolve or the call errors. Addresses are case-insensitive and need not be checksummed."
      }
     },
     "required": [
      "address"
     ]
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "openWorldHint": true
    },
    "execution": {
     "taskSupport": "forbidden"
    },
    "outputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "screeningId": {
       "type": "string",
       "description": "Immutable identifier for this screen (rsr_...)"
      },
      "address": {
       "type": "string",
       "description": "The screened address"
      },
      "score": {
       "type": "number",
       "description": "Signed reputation score from -100 to +100. Lower is worse."
      },
      "bandCode": {
       "type": "string",
       "description": "Band identifier, e.g. LOW_RISK, REPUTABLE"
      },
      "band": {
       "type": "string",
       "description": "Reputation band, e.g. Low Risk, Reputable"
      },
      "confidence": {
       "type": "string",
       "enum": [
        "High",
        "Medium",
        "Low"
       ],
       "description": "Engine confidence in the result"
      },
      "sanctioned": {
       "type": "boolean",
       "description": "True if the address is a direct OFAC match"
      },
      "transactionCount": {
       "type": "integer",
       "minimum": -9007199254740991,
       "maximum": 9007199254740991,
       "description": "Number of transactions analysed"
      },
      "summary": {
       "type": "string",
       "description": "One line verdict headline"
      },
      "evidence": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "code": {
          "type": "string",
          "description": "Stable code for this signal, e.g. OUTBOUND_DUST_SPRAY"
         },
         "factor": {
          "type": "string",
          "description": "Category of the signal, e.g. Behaviour Patterns"
         },
         "severity": {
          "type": "string",
          "enum": [
           "High",
           "Medium",
           "Low"
          ]
         },
         "message": {
          "type": "string",
          "description": "Short description of the signal"
         }
        },
        "required": [
         "code",
         "factor",
         "severity",
         "message"
        ],
        "additionalProperties": false
       },
       "description": "Up to 10 signals behind the verdict, most severe first"
      },
      "screenedAt": {
       "type": "string",
       "description": "When the screen ran (ISO-8601)"
      },
      "reportUrl": {
       "type": "string",
       "description": "Link to the full report on the Probity dashboard"
      }
     },
     "required": [
      "screeningId",
      "address",
      "score",
      "bandCode",
      "band",
      "confidence",
      "sanctioned",
      "transactionCount",
      "summary",
      "evidence",
      "screenedAt",
      "reportUrl"
     ],
     "additionalProperties": false
    }
   },
   {
    "name": "get_screening_narrative",
    "title": "Get screening narrative",
    "description": "Retrieve the enhanced Probity review for a completed screen by its screeningId. Costs zero credits. Returns the narrative and the key concerns it raises. It is generated in the background after screen_address returns, so it may briefly be pending. Retry shortly if so.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "screeningId": {
       "type": "string",
       "description": "The rsr_... id returned by screen_address. Must reference a completed screen; the narrative can be pending for a few seconds right after the screen returns."
      }
     },
     "required": [
      "screeningId"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    },
    "outputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "screeningId": {
       "type": "string",
       "description": "The screen this review belongs to"
      },
      "address": {
       "type": "string",
       "description": "The screened address"
      },
      "narrative": {
       "type": "string",
       "description": "The enhanced review text"
      },
      "concerns": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Key concerns raised by the review"
      },
      "reportUrl": {
       "type": "string",
       "description": "Link to the full report on the Probity dashboard"
      }
     },
     "required": [
      "screeningId",
      "address",
      "narrative",
      "concerns",
      "reportUrl"
     ],
     "additionalProperties": false
    }
   },
   {
    "name": "get_address_screening_history",
    "title": "Get address screening history",
    "description": "Retrieve the authenticated user's prior screening runs for a specific Ethereum address, each with the same detail as screen_address: reputation score, band, confidence, sanctioned flag, and the top evidence signals. Use it to recall context for an already-screened address. Costs zero credits, unlike screen_address which always runs a fresh screen. For runs across all your addresses, use get_screening_history.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "address": {
       "type": "string",
       "description": "Ethereum address (0x...) or .eth ENS name to look up historic screenings for"
      },
      "limit": {
       "description": "Number of past runs to return (1-50, default 5, newest first)",
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      }
     },
     "required": [
      "address"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    },
    "outputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "items": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "screeningId": {
          "description": "Immutable run id (rsr_...)",
