   {
    "name": "compare_screening_runs",
    "title": "Compare screening runs",
    "description": "Compare two completed screens by their screeningId and see what changed. Costs zero credits. Two runs of the same address show why the reputation score moved. Two different addresses show a side by side. Returns each run score, band, and confidence, a reason level diff, and the score change broken into its drivers. Small differences between runs of one address can be normal variation rather than a data change.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "runIdA": {
       "type": "string",
       "description": "First screeningId (rsr_...). Must be a completed screen you own."
      },
      "runIdB": {
       "type": "string",
       "description": "Second screeningId (rsr_...). Must be a completed screen you own."
      }
     },
     "required": [
      "runIdA",
      "runIdB"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    },
    "outputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "mode": {
       "type": "string",
       "enum": [
        "temporal_delta",
        "side_by_side"
       ],
       "description": "temporal_delta when both runs are the same address, else side_by_side"
      },
      "scoreDelta": {
       "type": "number",
       "description": "runA score minus runB score"
      },
      "runA": {
       "type": "object",
       "properties": {
        "screeningId": {
         "type": "string",
         "description": "The rsr_... id of this run"
        },
        "address": {
         "type": "string",
         "description": "The screened address"
        },
        "ensName": {
         "description": "ENS name for the address, when known",
         "type": [
          "string",
          "null"
         ]
        },
        "score": {
         "type": "number",
         "description": "Signed reputation score from -100 to +100. Lower is worse."
        },
        "bandCode": {
         "type": "string",
         "description": "Band identifier, e.g. LOW_RISK"
        },
        "band": {
         "type": "string",
         "description": "Reputation band, e.g. Low Risk"
        },
        "confidence": {
         "anyOf": [
          {
           "type": "string",
           "enum": [
            "High",
            "Medium",
            "Low"
           ]
          },
          {
           "type": "null"
          }
         ],
         "description": "Engine confidence for this run"
        },
        "transactionCount": {
         "type": "integer",
         "minimum": -9007199254740991,
         "maximum": 9007199254740991,
         "description": "Number of transactions analysed"
        },
        "screenedAt": {
         "type": "string",
         "description": "When this screen ran (ISO-8601)"
        },
        "reportUrl": {
         "type": "string",
         "description": "Link to the full report on the Probity dashboard"
        }
       },
       "required": [
        "screeningId",
        "address",
        "ensName",
        "score",
        "bandCode",
        "band",
        "confidence",
        "transactionCount",
        "screenedAt",
        "reportUrl"
       ],
       "additionalProperties": false
      },
      "runB": {
       "type": "object",
       "properties": {
        "screeningId": {
         "type": "string",
         "description": "The rsr_... id of this run"
        },
        "address": {
         "type": "string",
         "description": "The screened address"
        },
        "ensName": {
         "description": "ENS name for the address, when known",
         "type": [
          "string",
          "null"
         ]
        },
        "score": {
         "type": "number",
         "description": "Signed reputation score from -100 to +100. Lower is worse."
        },
        "bandCode": {
         "type": "string",
         "description": "Band identifier, e.g. LOW_RISK"
        },
        "band": {
         "type": "string",
         "description": "Reputation band, e.g. Low Risk"
        },
        "confidence": {
         "anyOf": [
          {
           "type": "string",
           "enum": [
            "High",
            "Medium",
            "Low"
           ]
          },
          {
           "type": "null"
          }
         ],
         "description": "Engine confidence for this run"
        },
        "transactionCount": {
         "type": "integer",
         "minimum": -9007199254740991,
         "maximum": 9007199254740991,
         "description": "Number of transactions analysed"
        },
        "screenedAt": {
         "type": "string",
         "description": "When this screen ran (ISO-8601)"
        },
        "reportUrl": {
         "type": "string",
         "description": "Link to the full report on the Probity dashboard"
        }
       },
       "required": [
        "screeningId",
        "address",
        "ensName",
        "score",
        "bandCode",
        "band",
        "confidence",
        "transactionCount",
        "screenedAt",
        "reportUrl"
       ],
       "additionalProperties": false
      },
      "reasonDiff": {
       "type": "object",
       "properties": {
        "added": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "code": {
            "type": "string"
           },
           "factor": {
            "type": "string"
           },
           "severity": {
            "type": "string",
            "enum": [
             "High",
             "Medium",
             "Low"
            ]
           },
           "message": {
            "type": "string"
           }
          },
          "required": [
           "code",
           "factor",
           "severity",
           "message"
          ],
          "additionalProperties": false
         },
         "description": "Reasons present in runA but not runB"
        },
        "removed": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "code": {
            "type": "string"
           },
