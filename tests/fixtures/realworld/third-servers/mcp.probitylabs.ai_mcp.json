           "string",
           "null"
          ]
         },
         "address": {
          "type": "string",
          "description": "The screened address"
         },
         "ensName": {
          "description": "ENS name for the address, when known",
          "type": [
           "string",
           "null"
          ]
         },
         "score": {
          "type": "number",
          "description": "Signed reputation score from -100 to +100. Lower is worse."
         },
         "bandCode": {
          "type": "string",
          "description": "Band identifier, e.g. LOW_RISK"
         },
         "band": {
          "type": "string",
          "description": "Reputation band, e.g. Low Risk"
         },
         "confidence": {
          "anyOf": [
           {
            "type": "string",
            "enum": [
             "High",
             "Medium",
             "Low"
            ]
           },
           {
            "type": "null"
           }
          ],
          "description": "Engine confidence for this run"
         },
         "sanctioned": {
          "type": "boolean",
          "description": "True if the address is a direct OFAC match"
         },
         "transactionCount": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Number of transactions analysed"
         },
         "evidence": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "code": {
             "type": "string"
            },
