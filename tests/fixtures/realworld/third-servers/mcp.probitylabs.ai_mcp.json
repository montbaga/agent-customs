             "High",
             "Medium",
             "Low"
            ]
           },
           "message": {
            "type": "string"
           }
          },
          "required": [
           "code",
           "factor",
           "severity",
           "message"
          ],
          "additionalProperties": false
         },
         "description": "Reasons present in runB but not runA"
        },
        "changed": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "code": {
            "type": "string"
           },
           "factor": {
            "type": "string"
           },
           "from": {
            "type": "string",
            "enum": [
             "High",
             "Medium",
             "Low"
            ]
           },
           "to": {
            "type": "string",
            "enum": [
             "High",
             "Medium",
             "Low"
            ]
           },
           "message": {
            "type": "string"
           }
          },
          "required": [
           "code",
           "factor",
           "from",
           "to",
           "message"
          ],
          "additionalProperties": false
         },
         "description": "Reasons in both runs whose severity changed from runB to runA"
        }
       },
       "required": [
        "added",
        "removed",
        "changed"
       ],
       "additionalProperties": false,
       "description": "What changed between the two runs at the reason level"
      },
      "compositionDiff": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "group": {
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "side": {
          "type": "string",
          "enum": [
           "raising",
           "lowering"
          ]
         },
         "change": {
          "type": "string",
          "enum": [
           "appeared",
           "strengthened",
           "weakened",
           "removed"
          ]
         },
         "widthPctA": {
          "type": "number"
         },
         "widthPctB": {
          "type": "number"
         }
        },
        "required": [
         "group",
         "label",
         "side",
         "change",
         "widthPctA",
         "widthPctB"
        ],
        "additionalProperties": false
       },
       "description": "Which score drivers differ between the runs"
      }
     },
     "required": [
      "mode",
      "scoreDelta",
      "runA",
      "runB",
      "reasonDiff",
      "compositionDiff"
     ],
     "additionalProperties": false
    }
   },
