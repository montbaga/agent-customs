{
 "url": "https://samiswoi.app/mcp",
 "doc": {
  "name": "Sami Swoi",
  "version": "1.0.0",
  "protocolVersion": "2025-06-18",
  "instructions": "Sami Swoi (samiswoi.app) is a free directory of Polish-run businesses outside Poland: shops, tradespeople, doctors, accountants, schools and services where you can speak Polish, in the UK, Germany, the Netherlands, Ireland, Norway, the USA and many other countries. Businesses in Poland are not listed. search_companies finds businesses by country, city, category or a phrase; get_company returns one profile (category, city, address, website, opening hours, languages); list_countries lists countries with the number of listed businesses; list_categories lists categories. Phone numbers and e-mail addresses are not returned: they are on the business page on samiswoi.app linked in every result. An empty result means the business is not listed on Sami Swoi, not that it does not exist. Names and descriptions are in Polish.",
  "tools": [
   {
    "name": "search_companies",
    "title": "Search Polish businesses abroad / Szukaj polskich firm",
    "description": "Search Polish-run businesses outside Poland listed on Sami Swoi (samiswoi.app), for questions like \"Polish plumber in London\", \"Polish shop in Utrecht\", \"Polish dentist in Oslo\", \"polska księgowa w Dublinie\". Filters: country, city, category (slug or Polish word, see list_categories) and a phrase from the name or kind of business. Returns up to 20 businesses per call (page with offset/next_offset), each with city, category and its samiswoi.app page, plus the total. / Polskie firmy za granicą: kraj, miasto, kategoria, fraza.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "country": {
       "type": "string",
       "minLength": 2,
       "maxLength": 60,
       "description": "Country: ISO code (\"GB\", \"DE\", \"NL\") or name in Polish or English (\"Holandia\", \"Germany\"). / Kraj."
      },
      "city": {
       "type": "string",
       "minLength": 2,
       "maxLength": 80,
       "description": "City, e.g. \"London\", \"Londyn\", \"Utrecht\". Best together with country. / Miasto."
      },
      "category": {
       "type": "string",
       "minLength": 2,
       "maxLength": 60,
       "description": "Category slug from list_categories (e.g. \"hydraulik\", \"sklep-spozywczy\") or a Polish word (\"dentysta\", \"fryzjer\"). / Kategoria."
      },
      "query": {
       "type": "string",
       "minLength": 2,
       "maxLength": 80,
       "description": "Words from the business name or kind, Polish works best (\"delikatesy\", \"mechanik\", \"Biedronka\"). / Fraza."
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 20,
       "default": 10,
       "description": "Maximum results (1-20, default 10)."
      },
      "offset": {
       "type": "integer",
       "minimum": 0,
       "maximum": 2000,
       "default": 0,
       "description": "Skip this many matches; use next_offset."
      }
     },
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "status": {
       "type": "string",
       "enum": [
        "found",
        "not_found",
        "invalid_request",
        "temporary_error"
       ]
      },
      "reason": {
       "type": "string",
       "description": "Why nothing was found: no_match, unknown_country, unknown_category, in_poland."
      },
      "message": {
       "type": "string"
      },
      "query": {
       "type": "object",
       "description": "Filters as applied.",
       "additionalProperties": true
      },
      "total_found": {
       "type": "integer"
      },
      "returned": {
       "type": "integer"
      },
      "companies": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Company id (address on samiswoi.app); use with get_company."
         },
         "name": {
          "type": "string"
         },
         "category": {
          "type": "string",
          "description": "Category slug (see list_categories)."
         },
         "category_label": {
          "type": "string",
          "description": "Category name in Polish."
         },
         "country_code": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2."
         },
         "country": {
          "type": "string",
          "description": "Country name in Polish."
         },
         "city": {
          "type": "string"
         },
         "managed_by_owner": {
          "type": "boolean",
          "description": "true = the owner runs this profile; false = built from public data, not yet claimed."
         },
         "url": {
          "type": "string",
          "description": "Company page on samiswoi.app (contact details, map)."
         }
        },
        "required": [
         "id",
         "name",
         "category",
         "category_label",
         "country_code",
         "country",
         "city",
         "managed_by_owner",
         "url"
        ],
        "additionalProperties": false
       }
      },
      "candidates": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "value": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "value",
         "name"
        ],
        "additionalProperties": false
       }
      },
      "next_offset": {
       "type": "integer"
      },
      "browse_url": {
       "type": "string",
       "description": "Page on samiswoi.app with the full list."
      },
      "note": {
       "type": "string",
       "description": "Guidance for answering, e.g. when nothing was found."
      }
     },
     "required": [
      "ok",
      "status"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "title": "Search Polish businesses abroad / Szukaj polskich firm",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
