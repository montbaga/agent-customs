{
 "url": "https://aisub.yuanwu.ai/mcp",
 "doc": {
  "name": "AISub AI subscription prices",
  "version": "1.0.0",
  "protocolVersion": "2025-06-18",
  "instructions": "AISub (https://aisub.yuanwu.ai) tracks published AI subscription prices by country and region, including website and App Store sources. Available products and periods depend on reviewed data. Claude website reference prices use get_reference_prices and have no country.\nStart with compare_prices for rankings across regions or get_region_prices for one country; call list_catalog when you need plan keys or region codes.\nReference prices prefer the tax-inclusive amount and use the tax-exclusive amount only when it is strictly lower. tax=unknown means the source does not state whether tax is included; it does not mean tax-free. Actual charges, including tax, are confirmed at checkout.\nApp Store yearly amounts are full-year totals. Billing periods are explicit only when stated in the source; same-item monthly/yearly amount pairs may be inferred and retain both pieces of evidence. Unlabeled single amounts follow the global period policy; monthly defaults remain inferred, while manual assignments have their own provenance. Unknown observations can be queried with interval=unknown and are not subscription quotes.\nChatGPT Business and Business 5x are priced per seat: the monthly amount is the per-seat monthly price, and the yearly amount is the per-seat monthly equivalent when paying yearly (full-year reference = yearly monthly equivalent × 12).\nEvery price response states when the quotes and the exchange rates were last updated (UTC). Quote these times and link the source URL when answering. A listed price does not prove that a user can buy the plan in that region.",
  "tools": [
   {
    "name": "list_catalog",
    "title": "List products, plans and regions",
    "description": "List the AI subscription products, sales channels, plan keys, billing intervals and regions that AISub tracks. Call without arguments for an overview; pass a product (and optionally a channel) to also get its region codes and the currencies available for conversion. Use the returned plan keys and region codes with the other tools.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "product": {
       "anyOf": [
        {
         "type": "string",
         "enum": [
          "chatgpt",
          "claude",
          "gemini",
          "perplexity",
          "grok"
         ]
        },
        {
         "type": "string",
         "pattern": "^app_[1-9]\\d{5,14}$"
        }
       ],
       "description": "Product key returned by list_catalog, including dynamically registered app_<apple-id> products."
      },
      "channel": {
       "description": "Sales channel: web (regional website prices) or app_store (iOS). Defaults to web for ChatGPT and app_store for other products. Claude website reference prices use get_reference_prices.",
       "type": "string",
       "enum": [
        "web",
        "app_store"
       ]
      },
      "locale": {
       "default": "en",
       "description": "Language for region and plan names: en (default) or zh.",
       "type": "string",
       "enum": [
        "zh",
        "en"
       ]
      }
     }
    },
    "annotations": {
     "title": "List products, plans and regions",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "products": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "product": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "provider": {
          "type": "string"
         },
         "channels": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "channel": {
             "type": "string",
             "enum": [
              "web",
              "app_store"
             ]
            },
            "quoteScope": {
             "type": "string",
             "const": "regional"
            },
            "plans": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "key": {
                "type": "string"
               },
               "name": {
                "type": "string"
               },
               "unit": {
                "type": "string",
                "enum": [
                 "person",
                 "seat",
                 "unknown"
                ]
               },
               "intervals": {
                "type": "array",
                "items": {
                 "type": "string",
                 "enum": [
                  "month",
                  "year"
                 ]
                }
               },
               "hasUnknownPeriod": {
                "type": "boolean"
               }
              },
              "required": [
               "key",
               "name",
               "unit",
               "intervals",
               "hasUnknownPeriod"
              ],
              "additionalProperties": false
             }
            },
            "regionCount": {
             "type": "integer",
             "minimum": -9007199254740991,
             "maximum": 9007199254740991
            },
            "pricedRegionCount": {
             "type": "integer",
             "minimum": -9007199254740991,
             "maximum": 9007199254740991
            },
            "regions": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "code": {
                "type": "string"
               },
               "name": {
                "type": "string"
               }
              },
              "required": [
               "code",
               "name"
              ],
              "additionalProperties": false
             }
            },
            "currencies": {
             "type": "array",
             "items": {
              "type": "string"
             }
            }
           },
           "required": [
            "channel",
            "quoteScope",
            "plans",
            "regionCount",
            "pricedRegionCount"
           ],
           "additionalProperties": false
          }
         }
        },
        "required": [
         "product",
         "name",
         "provider",
         "channels"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "products"
     ],
     "additionalProperties": false
    }
