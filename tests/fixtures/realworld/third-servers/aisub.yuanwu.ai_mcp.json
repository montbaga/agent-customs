   {
    "name": "compare_prices",
    "title": "Compare a plan's price across regions",
    "description": "Rank the price of one subscription plan (e.g. ChatGPT Plus, Claude Pro, Google AI Pro) across countries and regions, converted to one currency. Answers questions like \"where is ChatGPT Plus cheapest?\" or \"how much is Claude Pro in Turkey?\". Prices are monthly equivalents; for yearly billing the full-year total is also given. Each response includes when the prices and exchange rates were last updated.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "product": {
       "default": "chatgpt",
       "anyOf": [
        {
         "type": "string",
         "enum": [
          "chatgpt",
          "claude",
          "gemini",
          "perplexity",
          "grok"
         ]
        },
        {
         "type": "string",
         "pattern": "^app_[1-9]\\d{5,14}$"
        }
       ],
       "description": "Product key returned by list_catalog, including dynamically registered app_<apple-id> products."
      },
      "channel": {
       "description": "Sales channel: web (regional website prices) or app_store (iOS). Defaults to web for ChatGPT and app_store for other products. Claude website reference prices use get_reference_prices.",
       "type": "string",
       "enum": [
        "web",
        "app_store"
       ]
      },
      "plan": {
       "description": "Plan key from list_catalog, e.g. plus, pro, business (ChatGPT), claude_pro, gemini_ai_pro, perplexity_pro, supergrok. Defaults to the product's main plan.",
       "type": "string",
       "pattern": "^[a-zA-Z0-9_-]{1,80}$"
      },
      "interval": {
       "default": "month",
       "description": "Use unknown for observed App Store prices without a resolved period; these have no ranking or monthly equivalent.",
       "type": "string",
       "enum": [
        "month",
        "year",
        "unknown"
       ]
      },
      "currency": {
       "description": "ISO 4217 currency for converted reference prices, e.g. USD, CNY, EUR. Defaults to USD for en and CNY for zh.",
       "type": "string",
       "pattern": "^[A-Z]{3}$"
      },
      "tax": {
       "default": "all",
       "description": "Only regions whose reference price has this tax label.",
       "type": "string",
       "enum": [
        "all",
        "inclusive",
        "exclusive",
        "unknown"
       ]
      },
      "sort": {
       "default": "asc",
       "description": "asc: cheapest first (default); desc: most expensive first; name: alphabetical.",
       "type": "string",
       "enum": [
        "asc",
        "desc",
        "name"
       ]
      },
      "region": {
       "description": "Optional filter by region code, name or currency, e.g. JP, Japan, 日本, EUR.",
       "type": "string",
       "maxLength": 100
      },
      "limit": {
       "default": 10,
       "description": "Rows per page, 1–50.",
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      },
      "page": {
       "default": 1,
       "type": "integer",
       "minimum": 1,
       "maximum": 1000
      },
      "locale": {
       "default": "en",
       "description": "Language for region and plan names: en (default) or zh.",
       "type": "string",
       "enum": [
        "zh",
        "en"
       ]
      }
     }
    },
    "annotations": {
     "title": "Compare a plan's price across regions",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
