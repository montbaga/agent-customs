{
 "url": "https://lyricvideogenerator.app/api/mcp",
 "doc": {
  "name": "lyricvideogenerator",
  "version": "0.1.0",
  "protocolVersion": "2025-06-18",
  "tools": [
   {
    "name": "create_lyric_video",
    "title": "Create lyric video",
    "description": "Turns a song the user attached (MP3/WAV) into a word-synced lyric video and proposes three visual styles. Pass the lyrics if the user gave them; otherwise they are transcribed from the audio. Takes about 10–40 seconds. Creates a new project each call.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "audio": {
       "type": "object",
       "properties": {
        "download_url": {
         "type": "string"
        },
        "file_id": {
         "type": "string"
        },
        "mime_type": {
         "type": "string"
        },
        "file_name": {
         "type": "string"
        }
       },
       "required": [
        "download_url",
        "file_id"
       ],
       "description": "The song file the user attached"
      },
      "lyrics": {
       "description": "Full song lyrics, one line per sung line, if provided by the user",
       "type": "string",
       "maxLength": 20000
      },
      "title": {
       "description": "Song title, if known",
       "type": "string",
       "maxLength": 200
      }
     },
     "required": [
      "audio"
     ]
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "_meta": {
     "ui": {
      "resourceUri": "ui://lyricvideogenerator/studio-v1.html"
     },
     "openai/outputTemplate": "ui://lyricvideogenerator/studio-v1.html",
     "securitySchemes": [
      {
       "type": "noauth"
      },
      {
       "type": "oauth2",
       "scopes": [
        "openid",
        "profile",
        "email"
       ]
      }
     ],
     "openai/fileParams": [
      "audio"
     ],
     "openai/toolInvocation/invoking": "Syncing lyrics…",
     "openai/toolInvocation/invoked": "Lyric video ready"
    }
   },
   {
    "name": "get_lyric_video",
    "title": "Get lyric video",
    "description": "Returns a lyric video project's processing status, its three style options, the style now applied, and its numbered lyric lines.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "projectId": {
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "description": "projectId returned by create_lyric_video"
      }
     },
     "required": [
      "projectId"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "_meta": {
     "ui": {
      "resourceUri": "ui://lyricvideogenerator/studio-v1.html"
     },
     "openai/outputTemplate": "ui://lyricvideogenerator/studio-v1.html",
     "securitySchemes": [
      {
       "type": "noauth"
      },
      {
       "type": "oauth2",
       "scopes": [
        "openid",
        "profile",
        "email"
       ]
      }
     ]
    }
   },
   {
    "name": "choose_style",
    "title": "Choose style",
    "description": "Applies one of the three proposed style options (1, 2 or 3) to the lyric video. Replaces any edits made to the current style.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "projectId": {
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "description": "projectId returned by create_lyric_video"
      },
      "option": {
       "type": "integer",
       "minimum": 1,
       "maximum": 3
      }
     },
     "required": [
      "projectId",
      "option"
     ]
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "_meta": {
     "ui": {
      "resourceUri": "ui://lyricvideogenerator/studio-v1.html"
     },
     "openai/outputTemplate": "ui://lyricvideogenerator/studio-v1.html",
     "securitySchemes": [
      {
       "type": "noauth"
      },
      {
       "type": "oauth2",
       "scopes": [
        "openid",
        "profile",
        "email"
       ]
      }
     ]
    }
   },
   {
    "name": "update_style",
    "title": "Update style",
    "description": "Changes the look of the current lyric video style: layout, word animation, colors, font, text size, background, and chorus emphasis. Send only the fields to change. Colors are #RRGGBB. Unreadable color combinations and unknown fonts are corrected or rejected with a reason.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "projectId": {
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "description": "projectId returned by create_lyric_video"
      },
      "changes": {
       "type": "object",
       "properties": {
        "name": {
         "description": "Rename the style",
         "type": "string",
         "minLength": 1,
         "maxLength": 60
        },
        "template": {
         "description": "Layout: focus = one big centered line; scroll = lyrics scroll with the current line highlighted; caption = subtitle-style lower-left; poster = giant left-aligned words filling the frame",
         "type": "string",
         "enum": [
          "focus",
          "scroll",
          "caption",
          "poster"
         ]
        },
        "animation": {
         "description": "Word motion: word-highlight, karaoke (left-to-right fill), line-fade, word-pop, typewriter, word-kinetic (each word pops in on its beat), line-stack (lines push up)",
         "type": "string",
         "enum": [
          "word-highlight",
          "karaoke",
          "line-fade",
          "word-pop",
          "typewriter",
          "word-kinetic",
          "line-stack"
         ]
        },
        "palette": {
         "type": "object",
         "properties": {
          "bg": {
           "description": "Background color",
           "type": "string",
           "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "fg": {
           "description": "Lyric text color",
           "type": "string",
           "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "accent": {
           "description": "Current word / emphasis color",
           "type": "string",
           "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "muted": {
           "description": "Inactive lines color",
           "type": "string",
           "pattern": "^#[0-9a-fA-F]{6}$"
          }
         }
        },
        "font": {
         "description": "Any Google Fonts family name, e.g. \"Bebas Neue\"",
         "type": "string",
         "minLength": 1,
         "maxLength": 60
        },
        "fontWeight": {
         "anyOf": [
          {
           "type": "number",
           "const": 400
          },
          {
           "type": "number",
           "const": 500
          },
          {
           "type": "number",
           "const": 600
          },
          {
           "type": "number",
           "const": 700
          },
          {
           "type": "number",
           "const": 800
          },
          {
           "type": "number",
           "const": 900
          }
         ]
        },
        "fontScale": {
         "description": "Text size multiplier, 1 = template default",
         "type": "number",
         "minimum": 0.5,
         "maximum": 2.5
        },
        "uppercase": {
         "type": "boolean"
        },
        "align": {
         "type": "string",
         "enum": [
          "left",
          "center"
         ]
        },
        "background": {
         "description": "solid = palette.bg; gradient = from→to; cover-blur = blurred song cover (only when the song has a cover)",
         "type": "object",
         "properties": {
          "kind": {
           "type": "string",
           "enum": [
            "solid",
            "gradient",
            "cover-blur"
           ]
          },
          "from": {
           "type": "string",
           "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "to": {
           "type": "string",
           "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "angle": {
           "type": "number",
           "minimum": 0,
           "maximum": 360
          }
         },
         "required": [
          "kind"
         ]
        },
        "showCoverBadge": {
         "type": "boolean"
        },
        "chorus": {
         "description": "Overrides applied only during choruses",
         "type": "object",
         "properties": {
          "scale": {
           "type": "number",
           "minimum": 0.5,
           "maximum": 2.5
          },
          "accent": {
           "type": "string",
           "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "animation": {
           "type": "string",
           "enum": [
            "word-highlight",
            "karaoke",
            "line-fade",
            "word-pop",
            "typewriter",
            "word-kinetic",
            "line-stack"
           ]
          }
         }
        }
       },
       "additionalProperties": false
      }
     },
     "required": [
      "projectId",
      "changes"
     ]
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "openWorldHint": false
    },
