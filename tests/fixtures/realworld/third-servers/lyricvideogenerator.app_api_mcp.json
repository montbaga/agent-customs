   {
    "name": "edit_lyrics",
    "title": "Edit lyrics",
    "description": "Replaces the text of one lyric line (numbered from 1, as listed by get_lyric_video), keeping its timing. Use it to fix misheard or misspelled words.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "projectId": {
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "description": "projectId returned by create_lyric_video"
      },
      "line": {
       "type": "integer",
       "minimum": 1,
       "maximum": 9007199254740991
      },
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 500
      }
     },
     "required": [
      "projectId",
      "line",
      "text"
     ]
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "_meta": {
     "ui": {
      "resourceUri": "ui://lyricvideogenerator/studio-v1.html"
     },
