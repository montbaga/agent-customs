   {
    "name": "export_video",
    "title": "Export video",
    "description": "Free export: a 720p, 16:9 MP4 with a small watermark and a 2.5-second end card. It renders on the user's own computer inside the widget (about as long as the song), so this tool shows the widget and starts the export there; the user downloads the MP4 from the widget when it finishes. If their ChatGPT app can't render video, the widget offers to open the project in their browser instead.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "projectId": {
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "description": "projectId returned by create_lyric_video"
      }
     },
     "required": [
      "projectId"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "_meta": {
     "ui": {
      "resourceUri": "ui://lyricvideogenerator/studio-v1.html"
