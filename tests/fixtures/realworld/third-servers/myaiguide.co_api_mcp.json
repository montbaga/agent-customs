  "name": "My AI Guide",
  "version": "2.0.1",
  "protocolVersion": "2025-06-18",
  "instructions": "Public, read-only access to myaiguide.co: AI tools, repos and plugins, comparisons, news, glossary, blog, categories, leaderboards, and the editorial and trust pages (about, disclosure, methodology, corrections, privacy, terms). Every tool is read-only and needs no sign-in.",
  "tools": [
   {
    "name": "search",
    "title": "Search tools & repos",
    "description": "Full-text search across the AI tool directory and the repos/plugins catalog. Returns up to 10 matching tools and/or repos with their slugs and canonical URLs.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Search text (min 2 characters)."
      },
      "type": {
       "type": "string",
       "enum": [
        "tools",
        "repos",
        "all"
       ],
       "description": "Which catalogs to search. Default: all."
      }
     },
     "required": [
      "query"
     ],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "results": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "slug": {
          "type": "string"
         },
         "type": {
          "type": "string"
         }
        }
       }
      }
     },
     "required": [
      "results"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false,
     "title": "Search tools & repos"
    }
   },
   {
