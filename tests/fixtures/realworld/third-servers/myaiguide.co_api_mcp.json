    "inputSchema": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "description": "A myaiguide.co URL or site path, e.g. 'https://myaiguide.co/tools/claude' or '/about'."
      }
     },
     "required": [
      "id"
     ],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string"
