{
 "url": "https://www.artbooksociety.com/mcp",
 "doc": {
  "name": "Artbook Society — Public Catalog",
  "version": "1.0.0",
  "protocolVersion": "2025-06-18",
  "instructions": "Read-only access to the Artbook Society published catalog: books, artists, editors and events. No write operation is available. No personal data is ever returned — the same guarantees as the public website.",
  "tools": [
   {
    "name": "search_products",
    "title": "Search books",
    "description": "Search published books and artbooks on Artbook Society. Every keyword must match the title, subtitle, description, an author or contributor, the publisher or the edition type. Optional filters: price range, signed, numbered, limited edition, language.",
    "inputSchema": {
     "properties": {
      "query": {
       "description": "Keywords (at most 8), in English or French. Each keyword must match. Optional when a filter is given.",
       "minLength": 1,
       "maxLength": 200,
       "type": "string"
      },
      "limit": {
       "description": "Maximum number of results (default 10, max 20).",
       "minimum": 1,
       "maximum": 20,
       "type": "integer"
      },
      "min_price": {
       "description": "Minimum price in the currency shown in results.",
       "minimum": 0,
       "maximum": 1000000,
       "type": "number"
      },
      "max_price": {
       "description": "Maximum price in the currency shown in results.",
       "minimum": 0,
       "maximum": 1000000,
       "type": "number"
      },
      "signed": {
       "description": "Only signed copies.",
       "type": "boolean"
      },
      "numbered": {
       "description": "Only numbered copies.",
       "type": "boolean"
      },
      "limited_edition": {
       "description": "Only limited or collector's editions.",
       "type": "boolean"
      },
      "language": {
       "description": "Language of the text, ISO 639-1 code (for example fr or en).",
       "minLength": 2,
       "maxLength": 2,
       "type": "string"
      }
     },
     "type": "object"
    },
    "annotations": {
     "title": "Search books",
     "readOnlyHint": true,
     "idempotentHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "outputSchema": {
     "properties": {
      "results": {
       "description": "Matching published products.",
       "items": {
        "properties": {
         "id": {
          "type": "integer"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         },
         "price": {
          "type": "string"
         },
         "currency": {
          "type": "string"
         },
         "editor": {
          "properties": {
           "name": {
            "type": "string"
           }
          },
          "type": "object"
         },
         "edition_type": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      }
     },
     "type": "object"
    }
   },
   {
    "name": "get_product",
    "title": "Get book details",
    "description": "Fetch full public details for a single published product by its numeric id.",
    "inputSchema": {
     "properties": {
      "id": {
       "description": "Numeric product id.",
       "type": "integer"
      }
     },
     "type": "object",
     "required": [
      "id"
     ]
    },
    "annotations": {
     "title": "Get book details",
     "readOnlyHint": true,
     "idempotentHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "outputSchema": {
     "properties": {
      "id": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "image": {
       "type": "string"
      },
      "isbn": {
       "type": "string"
      },
      "price": {
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "editor": {
       "properties": {
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "author": {
       "properties": {
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "versions": {
       "items": {
        "properties": {
         "name": {
          "type": "string"
         },
         "price": {
          "type": "string"
         },
         "available": {
          "type": "boolean"
         }
        },
        "type": "object"
       },
       "type": "array"
      }
     },
     "type": "object"
    }
   },
   {
    "name": "get_artist",
    "title": "Get artist profile",
    "description": "Fetch full public details for a single artist by their numeric id.",
    "inputSchema": {
     "properties": {
      "id": {
       "description": "Numeric artist id.",
       "type": "integer"
      }
     },
     "type": "object",
     "required": [
      "id"
     ]
    },
    "annotations": {
     "title": "Get artist profile",
     "readOnlyHint": true,
     "idempotentHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "outputSchema": {
     "properties": {
      "id": {
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "biography": {
       "type": "string"
      },
      "image": {
       "type": "string"
      },
      "specialties": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    }
   },
   {
    "name": "get_editor",
    "title": "Get publisher profile",
    "description": "Fetch full public details for a single editor by their numeric id.",
    "inputSchema": {
     "properties": {
      "id": {
       "description": "Numeric editor id.",
       "type": "integer"
      }
     },
     "type": "object",
     "required": [
      "id"
     ]
    },
    "annotations": {
     "title": "Get publisher profile",
     "readOnlyHint": true,
     "idempotentHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "outputSchema": {
     "properties": {
      "id": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "biography": {
       "type": "string"
      },
      "website": {
       "type": "string"
      },
      "logo": {
       "type": "string"
      }
     },
     "type": "object"
    }
   },
   {
    "name": "list_events",
    "title": "List upcoming events",
    "description": "List published upcoming Artbook Society events, soonest first.",
    "inputSchema": {
     "properties": {
      "limit": {
       "description": "Maximum number of events (default 10, max 20).",
       "minimum": 1,
       "maximum": 20,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "annotations": {
     "title": "List upcoming events",
     "readOnlyHint": true,
     "idempotentHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "outputSchema": {
     "properties": {
      "results": {
       "description": "Published events.",
       "items": {
        "properties": {
         "id": {
          "type": "integer"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         },
         "start_date": {
          "type": "string"
         },
         "venue": {
          "type": "string"
         },
         "city": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      }
     },
     "type": "object"
    }
   }
  ]
 }
}