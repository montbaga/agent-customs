{
 "url": "https://plugmcp.ai/mcp-server",
 "doc": {
  "name": "PlugMCP directory",
  "version": "0.3.0",
  "protocolVersion": "2025-06-18",
  "instructions": "PlugMCP directory: search 70,000+ MCP servers and agent skills, then install one. Start with recommend_servers when the user describes a task, or search_servers when they name a product. Then call get_install with the user's client for the exact config. Results are compact cards with trust signals (official, verified, stars, health, auth). Page with cursor. Free without a key: 20 calls a day per address, 5 a minute. A free PlugMCP key gives 400 a day, 15 a minute and 60 an hour: https://plugmcp.ai/directory-mcp",
  "tools": [
   {
    "name": "search_servers",
    "title": "Search MCP servers",
    "description": "Find MCP servers by product name, publisher, or topic. Ranked by relevance (exact name, then publisher, then tags and description); the product's own server comes first when there is one (jira finds Atlassian's), duplicates merged. Returns compact cards with trust signals; call get_install next. When the user describes a job rather than a product, recommend_servers is one call instead of two.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Product, publisher, or topic, for example github, postgres, send email. Empty lists the most used servers."
      },
      "category": {
       "type": "string",
       "description": "Category slug: developer-tools, design-tools, databases, browser-automation, web-scraping, cloud-infrastructure, devops, productivity, communication, knowledge-memory, search, finance, security, data-science-ml, marketing, e-commerce, content-management, collaboration, analytics-monitoring, voice-agents, telephony, speech, autonomous-agents, project-management, documentation, game-development, mobile-development, social-media. list_categories has counts."
      },
      "client": {
       "type": "string",
       "enum": [
        "cursor",
        "claude-code",
        "claude-desktop",
        "vscode",
        "windsurf",
        "chatgpt",
        "codex",
        "gemini-cli",
        "grok",
        "grok-bot",
        "json"
       ],
       "description": "Only servers that work in this client (chatgpt keeps remote servers only). With fields=[install], adds the snippet for it."
      },
      "voice_ready": {
       "type": "boolean",
       "description": "Only servers suited to voice agents."
      },
      "remote_only": {
       "type": "boolean",
       "description": "Only hosted servers with a remote URL, no local install."
      },
      "official_only": {
       "type": "boolean",
       "description": "Only servers published by the product they connect to."
      },
      "verified_only": {
       "type": "boolean",
       "description": "Only servers that passed the live health check."
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 50,
       "description": "Results per page. Default 8. Without a key at most 10."
      },
      "cursor": {
       "type": "string",
       "description": "next_cursor from the previous page."
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "categories",
         "sources",
         "tools_count",
         "install"
        ]
       },
       "uniqueItems": true,
       "description": "Extra card fields. install (needs client) and tools_count need a PlugMCP key."
      },
      "response_format": {
       "type": "string",
       "enum": [
        "json",
        "markdown"
       ],
       "description": "json (default) or markdown for a human-readable text block. structuredContent is always JSON."
      }
     },
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string"
      },
      "total": {
       "type": "integer",
       "description": "Matches, counted up to 1000."
      },
      "total_capped": {
       "type": "boolean",
       "description": "True when there are more than 1000 matches."
      },
      "count": {
       "type": "integer"
      },
      "servers": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "slug": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "summary": {
          "type": "string"
         },
         "publisher": {
          "type": [
           "string",
           "null"
          ]
         },
         "hosting": {
          "type": "string",
          "enum": [
           "remote",
           "local"
          ]
         },
         "url": {
          "type": "string"
         },
         "trust": {
          "type": "object",
          "properties": {
           "official": {
            "type": "boolean",
            "description": "Published by the product it connects to."
           },
           "verified": {
            "type": "boolean",
            "description": "Passed PlugMCP's live health check."
           },
           "stars": {
            "type": "integer"
           },
           "last_commit_at": {
            "type": [
             "string",
             "null"
            ]
           },
           "health": {
            "type": "string",
            "enum": [
             "up",
             "down",
             "unchecked"
            ]
           },
           "health_checked_at": {
            "type": [
             "string",
             "null"
            ]
           },
           "auth": {
            "type": "string",
            "enum": [
             "none",
             "api_key",
             "oauth",
             "unknown"
            ]
           },
           "remote_url": {
            "type": [
             "string",
             "null"
            ]
           }
          },
          "required": [
           "official",
           "verified",
           "stars",
           "health",
           "auth"
          ]
         },
         "by_plugmcp": {
          "type": "boolean"
         },
         "added_at": {
          "type": [
           "string",
           "null"
          ]
         },
         "updated_at": {
          "type": [
           "string",
           "null"
          ]
         },
         "sources": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "categories": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "tools_count": {
          "type": [
           "integer",
           "null"
          ]
         },
         "install": {
          "type": "object"
         }
        },
        "required": [
         "slug",
         "name",
         "summary",
         "hosting",
         "url",
         "trust"
        ]
       }
      },
      "next_cursor": {
       "type": [
        "string",
        "null"
       ]
      },
      "hint": {
       "type": "string"
      }
     },
     "required": [
      "servers",
      "total",
      "count"
     ]
    },
    "annotations": {
     "title": "Search MCP servers",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
