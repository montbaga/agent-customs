   {
    "name": "get_install",
    "title": "Get install config",
    "description": "The exact config or command to install one server in one client: Cursor, Claude Code, Claude Desktop, VS Code, Windsurf, ChatGPT, Codex, Gemini CLI, Grok Build, Grok Bot, or plain JSON. For Grok Bot the value is the message to send in its chat. Includes the config file path and a one-click deeplink when the client has one.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "slug": {
       "type": "string",
       "description": "Listing slug from search results, for example github-github-mcp-server."
      },
      "client": {
       "type": "string",
       "enum": [
        "cursor",
        "claude-code",
        "claude-desktop",
        "vscode",
        "windsurf",
        "chatgpt",
        "codex",
        "gemini-cli",
        "grok",
        "grok-bot",
        "json"
       ],
       "description": "The agent the user installs into. grok is Grok Build (terminal) plus grok.com; grok-bot is Grok Bot, which takes a chat message. json returns a plain mcpServers block for any other client."
      }
     },
     "required": [
      "slug"
     ],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "slug": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "client": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "kind": {
       "type": "string",
       "enum": [
        "code",
        "steps",
        "unavailable"
       ]
      },
      "value": {
       "type": "string"
      },
      "file": {
       "type": "string"
      },
      "deeplink": {
       "type": "string"
      },
      "notes": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "host_url": {
       "type": "string"
      },
      "auth": {
       "type": "string"
      },
      "hosting": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "client",
      "kind",
      "value"
     ]
    },
    "annotations": {
     "title": "Get install config",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
