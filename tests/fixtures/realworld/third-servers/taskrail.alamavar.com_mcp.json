     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "product": {
       "type": "string",
       "minLength": 2,
       "maxLength": 500,
       "description": "Exact product name, model, and variant to buy used or refurbished"
      },
      "postal_code": {
       "type": "string",
       "pattern": "^\\d{5}(-\\d{4})?$",
       "description": "US postal code for delivery price and availability"
      },
      "minimum_savings_percent": {
       "default": 15,
       "description": "Minimum savings that would make a used option worthwhile",
       "type": "number",
       "minimum": 0,
       "maximum": 90
      }
     },
     "required": [
      "product"
     ]
    },
