       "type": [
        "string",
        "null"
       ]
      },
      "benefit": {
       "type": "string"
      },
      "benefit_detail": {
       "type": "string"
      },
      "status": {
       "type": "string",
       "const": "active"
      },
      "validity": {
       "type": "string",
       "enum": [
        "no-expiry",
        "terms-dependent"
       ]
      },
      "expires_at": {
       "type": "null",
       "description": "No fixed expiry timestamp is recorded. Consult validity and benefit_detail for trial windows and program conditions."
      },
      "last_verified": {
       "type": [
        "string",
        "null"
       ],
       "description": "ISO date of the historical check recorded in the verification log, not an expiry date."
      },
      "verification_methods": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "verification_log_url": {
       "type": "string"
      },
      "aliases": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "country_notes": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      },
      "review_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "signup_url": {
       "type": "string"
      },
      "how_to_apply": {
       "type": "string"
      },
      "keywords": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "brand",
      "slug",
      "category",
      "code",
      "benefit",
      "benefit_detail",
      "status",
      "validity",
      "expires_at",
      "last_verified",
      "verification_methods",
      "verification_log_url",
      "aliases",
      "country_notes",
      "url",
      "review_url",
      "signup_url",
      "how_to_apply",
      "keywords"
     ],
     "additionalProperties": false
    },
    "title": "Get the verified code for a brand",
    "description": "Returns the full verified-code record for one brand: the code, the benefit, how to apply it, last-verified date, availability notes, and the guide/review URLs. Match by brand name or slug (e.g. 'kraken', 'Bybit Card').",
    "inputSchema": {
     "type": "object",
     "properties": {
      "brand": {
       "type": "string",
       "description": "Brand name or slug, e.g. 'kraken' or 'Bybit Card'"
      }
     },
     "required": [
      "brand"
     ]
    }
   },
