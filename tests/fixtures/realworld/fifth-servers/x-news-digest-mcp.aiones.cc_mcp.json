{
 "url": "https://x-news-digest-mcp.aiones.cc/mcp",
 "doc": {
  "name": "x-news-digest-mcp",
  "version": "1.0.0",
  "protocolVersion": "2025-06-18",
  "tools": [
   {
    "name": "scan_accounts",
    "description": "扫描一批 X 账号近 N 小时的帖子，按热度排序输出中文资讯日报（核心工具）。accounts 支持逗号分隔账号或预设包名（ai_llm/ai_dev/tech_news/crypto），可混合。",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "accounts": {
       "default": "ai_llm",
       "description": "账号列表或预设包名，如 'OpenAI,dotey' 或 'ai_llm'",
       "type": "string"
      },
      "hours": {
       "default": 24,
       "description": "时间窗口（小时）",
       "type": "number"
      },
      "top": {
       "default": 10,
       "description": "最多返回条数",
       "type": "number"
      },
      "min_heat": {
       "default": 0,
       "description": "最低热度分门槛（热度=赞+转×3+藏×2+评×0.5）",
       "type": "number"
      },
      "mark_seen": {
       "default": true,
       "description": "是否记入已见库（下次自动跳过）",
       "type": "boolean"
      }
     }
    }
   },
   {
    "name": "search_x_news",
    "description": "按关键词搜索 X 帖子并按热度排序。注意：免费镜像搜索索引较浅，空结果不代表没有内容，主通道请用 scan_accounts。",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "query": {
       "type": "string",
       "description": "搜索关键词，支持 'AI agent'、'from:OpenAI' 等"
      },
      "hours": {
       "default": 24,
       "description": "只保留近 N 小时的结果",
       "type": "number"
      },
      "count": {
       "default": 20,
       "description": "抓取条数",
       "type": "number"
      }
     },
     "required": [
      "query"
     ]
    }
   },
   {
    "name": "get_post",
    "description": "读取单条 X 帖子详情（含 views/媒体信息），接受帖子 URL 或数字 id。",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "url_or_id": {
       "type": "string",
       "description": "帖子链接或 id"
      }
     },
     "required": [
      "url_or_id"
     ]
    }
   },
   {
    "name": "list_presets",
    "description": "列出内置精选账号包（scan_accounts 可直接引用包名）。",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {}
    }
   },
   {
    "name": "reset_seen",
    "description": "清空已见去重库（下次扫描会把时间窗内命中帖当新帖再推一遍，慎用）。",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {}
    }
   }
  ]
 }
}