       "type": "string"
      },
      "destinationAddress": {
       "type": [
        "string",
        "null"
       ]
      },
      "network": {
       "type": "string"
      },
      "chainId": {
       "type": "integer"
      },
      "safeToProceed": {
       "type": "boolean"
      },
      "decision": {
       "type": "string",
       "enum": [
        "safe_to_pay",
        "needs_funding",
        "needs_gas",
        "review_destination",
        "reject"
       ]
      },
      "riskLevel": {
       "type": "string",
       "enum": [
        "low",
        "medium",
        "high"
       ]
      },
      "recommendedAction": {
       "type": "string"
      },
      "eth": {
       "type": "string"
      },
      "usdc": {
       "type": "string"
      },
      "checks": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": {}
       }
      },
      "alerts": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "limitations": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "blockNumber": {
       "type": "integer"
      },
      "observedAt": {
       "type": "string"
      }
     },
     "required": [
      "address",
