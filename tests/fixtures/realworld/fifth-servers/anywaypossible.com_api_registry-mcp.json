       },
       "minItems": 1,
       "maxItems": 5,
       "description": "One to five buyer search phrases used for listing rank and competitor analysis."
      },
      "excludePayers": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^0x[a-fA-F0-9]{40}$"
