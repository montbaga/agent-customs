   {
    "annotations": {
     "destructiveHint": false,
     "readOnlyHint": false
    },
    "description": "Atomically add a study text, related links and ordered learning trail near similar map posts.\n\nFirst call find_related_map_topics. Put selected existing topic IDs in learning order;\nthe new post is appended as the last trail step. The server infers a category and position.\nA stable idempotency_key makes retries safe. Contributors create drafts for review.\n",
    "inputSchema": {
     "properties": {
      "title": {
       "title": "Title",
       "type": "string"
      },
      "summary": {
       "title": "Summary",
       "type": "string"
      },
      "content": {
       "title": "Content",
       "type": "string"
      },
      "related_topics": {
       "items": {
        "$ref": "#/$defs/StudyRelatedTopic"
       },
       "title": "Related Topics",
       "type": "array"
      },
      "idempotency_key": {
       "title": "Idempotency Key",
       "type": "string"
      },
      "map_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Map Id"
      },
      "category_topic_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Category Topic Id"
      },
      "trail_title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Trail Title"
      },
      "trail_summary": {
       "default": "",
       "title": "Trail Summary",
       "type": "string"
      },
      "language": {
       "default": "en",
       "title": "Language",
       "type": "string"
      }
     },
     "required": [
      "title",
      "summary",
      "content",
      "related_topics",
      "idempotency_key"
     ],
     "type": "object",
     "$defs": {
      "StudyRelatedTopic": {
       "properties": {
        "topic_id": {
         "format": "uuid",
         "title": "Topic Id",
         "type": "string"
        },
        "relationship_kind": {
         "default": "related_to",
         "enum": [
          "related_to",
          "prerequisite_for",
          "example_of",
          "contradicts"
         ],
         "title": "Relationship Kind",
         "type": "string"
        },
        "direction": {
         "default": "existing_to_new",
         "enum": [
          "existing_to_new",
          "new_to_existing"
         ],
         "title": "Direction",
         "type": "string"
        },
        "explanation": {
         "default": "Connected in the same study path.",
         "maxLength": 1000,
         "minLength": 2,
         "title": "Explanation",
         "type": "string"
        }
       },
       "required": [
        "topic_id"
       ],
       "title": "StudyRelatedTopic",
       "type": "object"
      }
     },
     "title": "publish_study_pathArguments"
    },
    "name": "publish_study_path",
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "title": "publish_study_pathDictOutput"
    },
    "title": "Publish a study path",
    "securitySchemes": [
