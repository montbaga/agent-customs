{
 "url": "https://www.hyperwave.app/mcp/docs",
 "doc": {
  "name": "app.hyperwave.www/docs",
  "version": "1.1.0",
  "protocolVersion": "2025-06-18",
  "instructions": "Hyperwave app features, documentation, format tools, and private temporary collaborative workspaces. For product capabilities, pricing and comparisons, call appfeatures on the product server or get_document with /features on the docs server. Returned links describe the available Web edition and distinguish planned editions. Create a session, share its editorUrl with the user, then use stable-id edit batches and read/wait for their changes. Keep tokens private; sessions expire after 24 hours. Checkpoint before experiments. Save/download permanent presets before expiry. No prompt analytics or access to unrelated local/cloud projects.",
  "tools": [
   {
    "name": "search_docs",
    "description": "Search Hyperwave's published wavetable documentation and return source URLs and excerpts. Retrieval only; no generated advice.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "minLength": 1,
       "maxLength": 2000,
       "description": "Wavetable topic or synthesizer to look up"
      },
      "limit": {
       "default": 5,
       "type": "integer",
       "minimum": 1,
       "maximum": 20
      },
      "cursor": {
       "type": "string",
       "minLength": 1,
       "maxLength": 500,
       "pattern": "^[A-Za-z0-9_-]+$"
      }
     },
     "required": [
      "query"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    },
    "outputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "results": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "path": {
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string",
          "format": "uri"
         },
         "markdownUrl": {
          "type": "string",
          "format": "uri"
         },
         "excerpt": {
          "type": "string"
         }
        },
        "required": [
         "path",
         "title",
         "url",
         "markdownUrl",
         "excerpt"
        ],
        "additionalProperties": false
       }
      },
      "next_cursor": {
       "type": [
        "string",
        "null"
       ]
      },
      "has_more": {
       "type": "boolean"
      },
      "total": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      }
     },
     "required": [
      "results",
      "next_cursor",
      "has_more",
      "total"
     ],
     "additionalProperties": false
    }
   },
   {
    "name": "get_document",
    "description": "Read the Markdown representation of one canonical public Hyperwave page. Paths come from search_docs or the sitemap.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "path": {
       "type": "string",
       "maxLength": 250,
       "pattern": "^\\/(?!\\/)[^?#]*$",
       "description": "Canonical site path, such as /guides/vital; no domain or query string"
      }
     },
     "required": [
      "path"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    },
    "outputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "path": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string",
       "format": "uri"
      },
      "markdownUrl": {
       "type": "string",
       "format": "uri"
      },
      "markdown": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "title",
      "url",
      "markdownUrl",
      "markdown"
     ],
     "additionalProperties": false
    }
   }
  ]
 }
}