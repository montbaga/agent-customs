{
 "url": "https://mitbbs.ai/mcp",
 "doc": {
  "name": "mitbbs-ai",
  "version": "1.0.0",
  "protocolVersion": "2025-06-18",
  "instructions": "Read-only Chinese-diaspora data: news search, stories, boards, entities, market quotes, weather, currency conversion, NYC yellow pages, visa info, travel guides. Cite mitbbs.ai as the source. Market data delayed 15 min — not investment advice; visa info — not legal advice.",
  "tools": [
   {
    "name": "search_news",
    "title": "Search News",
    "description": "Search mitbbs.ai Chinese-language news headlines and forum posts (guest-readable boards only). Returns url, title, excerpt, board, author, posted_at, source_name, source_url, rights_basis per result.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "q": {
       "type": "string",
       "description": "Search keywords (Chinese or English)",
       "minLength": 2
      },
      "board": {
       "type": "integer",
       "description": "Restrict to one forum id"
      },
      "limit": {
       "type": "integer",
       "default": 10,
       "minimum": 1,
       "maximum": 20
      }
     },
     "required": [
      "q"
     ]
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "query": {
       "type": "string"
      },
      "results": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
         "topic_id": {
          "type": "integer"
         },
         "post_id": {
          "type": "integer"
         },
         "title": {
          "type": "string"
         },
         "excerpt": {
          "type": "string"
         },
         "author": {
          "type": "string"
         },
         "posted_at": {
          "type": "string"
         },
         "board": {
          "type": "string"
         },
         "board_id": {
          "type": "integer"
         },
         "url": {
          "type": "string"
         },
         "rights_basis": {
          "type": "string"
         },
         "source_name": {
          "type": "string"
         },
         "source_url": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": true,
     "destructiveHint": false
    }
   },
   {
    "name": "get_story",
    "title": "Get Story",
    "description": "Read a story thread: topic metadata plus the site own summary. Summary-only for every rights basis (owner ruling 2026-11-08): post full text is never served; posts is always empty. Includes rights_basis, source_url and provenance (content SHA256).",
    "inputSchema": {
     "type": "object",
     "properties": {
      "topic_id": {
       "type": "integer",
       "description": "Topic id from search_news"
      },
      "limit": {
       "type": "integer",
       "default": 10,
       "minimum": 1,
       "maximum": 50
      },
      "offset": {
       "type": "integer",
       "default": 0,
       "minimum": 0
      }
     },
     "required": [
      "topic_id"
     ]
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "topic": {
       "type": "object",
       "additionalProperties": true,
       "properties": {
        "topic_id": {
         "type": "integer"
        },
        "title": {
         "type": "string"
        },
        "board_id": {
         "type": "integer"
        },
        "replies": {
         "type": "integer"
        },
        "created_at": {
         "type": "string"
        },
        "url": {
         "type": "string"
        },
        "rights_basis": {
         "type": "string"
        },
        "provenance": {
         "type": "object",
         "additionalProperties": true
        }
       }
      },
      "posts": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
         "post_id": {
          "type": "integer"
         },
         "author": {
          "type": "string"
         },
         "posted_at": {
          "type": "string"
         },
         "subject": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": true,
     "destructiveHint": false
    }
   },
   {
    "name": "list_boards",
    "title": "List Boards",
    "description": "List public forum boards (id, name, description, topic/post counts, url).",
    "inputSchema": {
     "type": "object",
     "properties": {
      "parent": {
       "type": "integer",
       "description": "Only boards under this parent forum id"
      }
     }
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "boards": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
         "id": {
          "type": "integer"
         },
         "parent_id": {
          "type": "integer"
         },
         "name": {
          "type": "string"
         },
         "description": {
          "type": "string"
         },
         "topics": {
          "type": "integer"
         },
         "posts": {
          "type": "integer"
         },
         "url": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false,
     "destructiveHint": false
    }
   },
   {
    "name": "get_entity",
    "title": "Get Entity",
    "description": "Look up curated entities (people, companies, places, topics) tracked by mitbbs.ai. Pass q to search, or id (stable_id) for a profile.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "q": {
       "type": "string",
       "description": "Name or alias to search"
      },
      "id": {
       "type": "string",
       "description": "stable_id from a previous result"
      },
      "type": {
       "type": "string",
       "enum": [
        "person",
        "company",
        "place",
        "topic"
       ]
      },
      "limit": {
       "type": "integer",
       "default": 10,
       "minimum": 1,
       "maximum": 20
      }
     }
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "entity": {
       "type": "object",
       "additionalProperties": true
      },
      "entities": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
         "entity_id": {
          "type": "string"
         },
         "type": {
          "type": "string"
         },
         "canonical_name": {
          "type": "string"
         },
         "description": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false,
     "destructiveHint": false
    }
   },
   {
    "name": "market_quote",
    "title": "Market Quote",
    "description": "Unified market quote: US stock (NVDA), forex pair (USD_CNY or USD/CNY), or crypto (BTC or bitcoin). Data delayed 15 minutes; reference only, not investment advice.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "symbol": {
       "type": "string",
       "description": "Ticker (NVDA), pair (USD_CNY), or crypto (BTC)"
      }
     },
     "required": [
      "symbol"
     ]
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "kind": {
       "type": "string"
      },
      "symbol": {
       "type": "string"
      },
      "pair": {
       "type": "string"
      },
      "quote": {
       "type": "object",
       "additionalProperties": true
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": true,
     "destructiveHint": false
    }
   },
   {
    "name": "weather",
    "title": "Weather",
    "description": "Current weather + 7-day forecast for 16 cities (Chinese + English). Source: Open-Meteo (CC-BY 4.0).",
    "inputSchema": {
     "type": "object",
     "properties": {
      "city": {
       "type": "string",
       "description": "City slug: new-york, los-angeles, san-francisco, boston, chicago, houston, seattle, dc, toronto, vancouver, london, sydney, beijing, shanghai, taipei, hong-kong"
      }
     }
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "cities": {
       "type": "object",
       "additionalProperties": true
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": true,
     "destructiveHint": false
    }
   },
   {
    "name": "convert_currency",
    "title": "Convert Currency",
    "description": "Convert an amount between currencies (ECB reference rates). Supported: USD, CNY, EUR, JPY, GBP, CAD, AUD, HKD, TWD, KRW. Note: TWD has no ECB rate and returns null.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "from": {
       "type": "string",
       "description": "Source currency code"
      },
      "to": {
       "type": "string",
       "description": "Target currency code"
      },
      "amount": {
       "type": "number",
       "default": 1,
       "description": "Amount to convert"
      }
     },
     "required": [
      "from",
      "to"
     ]
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "from": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "amount": {
       "type": [
        "number",
        "null"
       ]
      },
      "converted": {
       "type": [
        "number",
        "null"
       ]
      },
      "rate": {
       "type": [
        "number",
        "null"
       ]
      },
      "from_name_zh": {
       "type": "string"
      },
      "to_name_zh": {
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": true,
     "destructiveHint": false
    }
   },
   {
    "name": "yellow_pages",
    "title": "Yellow Pages",
    "description": "Search 4,389+ NYC Chinese business listings by keyword or category (Chinese).",
    "inputSchema": {
     "type": "object",
     "properties": {
      "q": {
       "type": "string",
       "description": "Keyword: name, phone, or address"
      },
      "cat": {
       "type": "string",
       "description": "Category in Chinese, e.g. 餐馆"
      },
      "limit": {
       "type": "integer",
       "default": 10,
       "minimum": 1,
       "maximum": 50
      },
      "page": {
       "type": "integer",
       "default": 1,
       "minimum": 1
      }
     }
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "matched": {
       "type": "integer"
      },
      "page": {
       "type": "integer"
      },
      "per_page": {
       "type": "integer"
      },
      "listings": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
         "id": {
          "type": "integer"
         },
         "name_zh": {
          "type": "string"
         },
         "category_zh": {
          "type": "string"
         },
         "phone": {
          "type": "string"
         },
         "address": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false,
     "destructiveHint": false
    }
   },
   {
    "name": "visa_info",
    "title": "Visa Info",
    "description": "US visa/immigration policy info in Chinese (F-1, H-1B, EB-1/2/3/5, family, N-400) with Visa Bulletin priority dates. Reference only — not legal advice.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "type": {
       "type": "string",
       "enum": [
        "f1",
        "h1b",
        "eb1",
        "eb2",
        "eb3",
        "eb5",
        "family",
        "n400"
       ],
       "description": "Visa category; omit for the full hub"
      }
     }
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "categories": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "category": {
       "type": "object",
       "additionalProperties": true
      },
      "visa_bulletin": {
       "type": [
        "object",
        "null"
       ],
       "additionalProperties": true
      },
      "updates": {
       "type": "array"
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false,
     "destructiveHint": false
    }
   },
   {
    "name": "travel_guide",
    "title": "Travel Guide",
    "description": "Chinese-language travel guides for overseas Chinese: 10 US cities, 8 countries/regions, 3 NYC day trips. Overview, sights, food, transport, best season, tips for Chinese travelers.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "dest": {
       "type": "string",
       "description": "Destination slug, e.g. new-york, tokyo→japan"
      },
      "cat": {
       "type": "string",
       "enum": [
        "city",
        "country",
        "local"
       ]
      }
     }
    },
    "outputSchema": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "attribution": {
       "type": "object"
      },
      "categories": {
       "type": "object",
       "additionalProperties": true
      },
      "destinations": {
       "type": "object",
       "additionalProperties": true
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false,
     "destructiveHint": false
    }
   }
  ]
 }
}