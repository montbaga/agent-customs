             "SHOT",
             "ELEMENT",
             "PRODUCTION_UNIT",
             "DELIVERABLE",
             "ESTIMATE"
            ]
           },
           "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
           },
           "targetApprovalState": {
            "type": "string",
            "enum": [
             "DRAFT",
             "READY_FOR_REVIEW",
             "APPROVED",
             "FROZEN",
             "CHANGES_REQUESTED"
            ]
           },
           "changesCamera": {
            "type": "boolean"
           },
           "changesMiseEnScene": {
