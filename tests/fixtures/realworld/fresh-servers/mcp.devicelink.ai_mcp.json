{
 "url": "https://mcp.devicelink.ai/mcp",
 "doc": {
  "name": "DeviceLink MCP",
  "version": "0.1.0",
  "protocolVersion": "2025-06-18",
  "tools": [
   {
    "name": "health",
    "description": "Simple health check — returns server status.",
    "inputSchema": {
     "type": "object",
     "properties": {}
    },
    "annotations": {
     "title": "Health Check",
     "readOnlyHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "discover",
    "description": "Discover workspaces, devices, shared folders, and available tools in one call. Call this first to understand what is available before invoking device_tool_call. Automatically selects workspace, device, or folder when only one option exists; returns a list of choices when disambiguation is needed.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "workspace_id": {
       "type": "string",
       "minLength": 1
      },
      "device_id": {
       "type": "string",
       "minLength": 1
      },
      "directory_id": {
       "type": "string",
       "minLength": 1
      },
      "devices": {
       "type": "object",
       "properties": {
        "mode": {
         "type": "string",
         "enum": [
          "basic",
          "stat"
         ],
         "default": "basic"
        }
       },
       "additionalProperties": false
      },
      "directories": {
       "type": "object",
       "properties": {
        "mode": {
         "type": "string",
         "enum": [
          "basic"
         ],
         "default": "basic"
        },
        "preview_limit": {
         "type": "integer",
         "minimum": 1,
         "maximum": 50,
         "default": 20
        }
       },
       "additionalProperties": false
      },
      "tools": {
       "type": "object",
       "properties": {
        "mode": {
         "type": "string",
         "enum": [
          "basic",
          "digest",
          "full"
         ],
         "default": "basic"
        }
       },
       "additionalProperties": false
      }
     },
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
     "title": "Discover Resources",
     "readOnlyHint": true,
     "destructiveHint": false,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "device_tool_call",
    "description": "Execute a tool on a connected device. Use discover first to find available tool names, device IDs, and workspace IDs. When workspace_id, device_id, or directory_id are omitted, the server uses the unambiguous default if one exists.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "tool": {
       "type": "string",
       "minLength": 1
      },
      "args": {
       "type": "object",
       "additionalProperties": {}
      },
      "workspace_id": {
       "type": "string",
       "minLength": 1
      },
      "device_id": {
       "type": "string",
       "minLength": 1
      },
      "directory_id": {
       "type": "string",
       "minLength": 1
      },
      "request_id": {
       "type": "string",
       "minLength": 1
      }
     },
     "required": [
      "tool"
     ],
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
     "title": "Device Tool Call",
     "readOnlyHint": false,
     "destructiveHint": true,
     "openWorldHint": false,
     "idempotentHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "device_ping",
    "description": "Check that a device is reachable and how long a round trip takes. Reads no files, needs no shared folder and consumes no credit, so it is the safe way to prove a device is live.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "workspace_id": {
       "type": "string",
       "minLength": 1
      },
      "device_id": {
       "type": "string",
       "minLength": 1
      },
      "echo": {
       "type": "string",
       "maxLength": 64
      }
     },
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
     "title": "Device Ping",
     "readOnlyHint": true,
     "destructiveHint": false,
     "openWorldHint": false,
     "idempotentHint": true
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   }
  ]
 }
}