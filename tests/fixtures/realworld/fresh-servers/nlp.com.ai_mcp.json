{
 "url": "https://nlp.com.ai/mcp",
 "doc": {
  "name": "NLP.COM.AI Open Model Catalog",
  "version": "1.0.0",
  "protocolVersion": "2025-06-18",
  "instructions": "Search the curated NLP.COM.AI catalogue of downloadable open-weight text-to-text model and model-family releases. Results link to canonical catalogue pages and primary release sources.",
  "tools": [
   {
    "name": "search_models",
    "title": "Search open-weight model releases",
    "description": "Search curated open-weight model release records by model name, developer, license, parameter or context description, and technical features. Returns canonical NLP.COM.AI pages and primary sources.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200,
       "description": "Words that every matching record must contain."
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 20,
       "default": 10
      }
     },
     "required": [
      "query"
     ],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "count": {
       "type": "integer",
       "minimum": 0
      },
      "models": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "slug": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "developer": {
          "type": "string"
         },
         "release_date": {
          "type": [
           "string",
           "null"
          ]
         },
         "parameters": {
          "type": "string"
         },
         "context_window": {
          "type": "string"
         },
         "license": {
          "type": "string"
         },
         "page_url": {
          "type": "string"
         }
        },
        "required": [
         "slug",
         "name",
         "developer",
         "release_date",
         "parameters",
         "context_window",
         "license",
         "page_url"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "count",
      "models"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "recent_models",
    "title": "List recent open-weight model releases",
    "description": "Return the newest curated open-weight model release records, optionally limited to releases on or after an ISO 8601 date.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "since": {
       "type": "string",
       "format": "date",
       "description": "Optional inclusive release date in YYYY-MM-DD form."
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 50,
       "default": 20
      }
     },
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "count": {
       "type": "integer",
       "minimum": 0
      },
      "models": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "slug": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "developer": {
          "type": "string"
         },
         "release_date": {
          "type": [
           "string",
           "null"
          ]
         },
         "parameters": {
          "type": "string"
         },
         "context_window": {
          "type": "string"
         },
         "license": {
          "type": "string"
         },
         "page_url": {
          "type": "string"
         }
        },
        "required": [
         "slug",
         "name",
         "developer",
         "release_date",
         "parameters",
         "context_window",
         "license",
         "page_url"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "count",
      "models"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "get_model",
    "title": "Get a complete open-weight model record",
    "description": "Return the complete curated record for one model or model-family release, addressed by the slug returned from search_models or recent_models.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "slug": {
       "type": "string",
       "minLength": 1,
       "maxLength": 255,
       "description": "Exact canonical model slug."
      }
     },
     "required": [
      "slug"
     ],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "model": {
       "type": "object",
       "properties": {
        "slug": {
         "type": "string"
        },
        "source_file": {
         "type": [
          "string",
          "null"
         ]
        },
        "release_date": {
         "type": [
          "string",
          "null"
         ]
        },
        "date": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "developer": {
         "type": "string"
        },
        "parameters": {
         "type": "string"
        },
        "context_window": {
         "type": "string"
        },
        "license": {
         "type": "string"
        },
        "key_features": {
         "type": "string"
        },
        "paper_url": {
         "type": "string"
        },
        "links": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "page_url": {
         "type": "string"
        },
        "record_updated_at": {
         "type": "string"
        }
       },
       "required": [
        "slug",
        "source_file",
        "release_date",
        "date",
        "name",
        "developer",
        "parameters",
        "context_window",
        "license",
        "key_features",
        "paper_url",
        "links",
        "page_url",
        "record_updated_at"
       ],
       "additionalProperties": false
      }
     },
     "required": [
      "model"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   }
  ]
 }
}