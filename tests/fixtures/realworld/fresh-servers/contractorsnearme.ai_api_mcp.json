     "properties": {
      "contractor_slug": {
       "type": "string",
       "minLength": 1
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      }
     },
     "required": [
      "contractor_slug"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "idempotentHint": true
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "list_trades",
    "title": "List Trades",
    "description": "Get a list of all available trades/professions. Returns filtered list of contractor trades from the directory.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {}
    },
    "annotations": {
     "readOnlyHint": true,
