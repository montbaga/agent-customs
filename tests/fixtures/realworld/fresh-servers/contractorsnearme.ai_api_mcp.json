{
 "url": "https://contractorsnearme.ai/api/mcp",
 "doc": {
  "name": "contractors-near-me",
  "version": "1.3.0",
  "protocolVersion": "2025-06-18",
  "tools": [
   {
    "name": "search_contractors",
    "title": "Search Contractors",
    "description": "Search active contractors by trade, place (ZIP, city, state or province), company name or service words, and geo radius. Uses the same matching, ranking (distance, Bayesian rating, review count, profile completeness) and duplicate merging as contractorsnearme.ai/search. is_verified is true only when the contractor's license passed a check against a state board record.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "trade": {
       "type": "string",
       "minLength": 1
      },
      "state": {
       "type": "string",
       "minLength": 2,
       "maxLength": 40
      },
      "city": {
       "type": "string",
       "minLength": 1
      },
      "location": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200
      },
      "q": {
       "type": "string",
       "minLength": 1
      },
      "lat": {
       "type": "number",
       "minimum": -90,
       "maximum": 90
      },
      "lng": {
       "type": "number",
       "minimum": -180,
       "maximum": 180
      },
      "radius_miles": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "limit": {
       "type": "integer",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991
      },
      "sort": {
       "type": "string",
       "enum": [
        "relevance",
        "distance",
        "rating",
        "reviews",
        "name"
       ]
      },
      "accountType": {
       "type": "string",
       "enum": [
        "gc",
        "supplier",
        "subcontractor",
        "customer"
       ]
      },
      "contractorCategory": {
       "type": "string",
       "enum": [
        "gc",
        "supplier",
        "subcontractor"
       ]
      },
      "customerOnly": {
       "type": "boolean"
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "idempotentHint": true
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "get_contractor",
    "title": "Get Contractor Profile",
    "description": "Get detailed contractor profile by slug. Returns full profile including about text, contact info, and trade details. is_verified is true only when the contractor's license passed a check against a state board record.",
    "inputSchema": {
