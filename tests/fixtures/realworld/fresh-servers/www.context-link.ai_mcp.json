        "https://www.google.com"
       ]
      },
      "domain": "de4fcccd39d75091e9b1616e387a41e7.claudemcpcontent.com"
     },
     "openai/widgetDescription": "Shows only the list of sources Context Link consulted — it does not display the answer or retrieved content, so the assistant must still present those in its reply.",
     "openai/widgetPrefersBorder": true,
     "openai/widgetDomain": "https://www.context-link.ai",
     "openai/widgetCSP": {
      "connect_domains": [
       "https://www.context-link.ai"
      ],
      "resource_domains": [
       "https://www.context-link.ai",
       "https://www.google.com"
      ]
     }
    }
   }
  ]
 }
