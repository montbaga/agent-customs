       "description": "Words to look for, e.g. 'who removes personal details'"
      },
      "topic": {
       "description": "Limit to one topic",
       "type": "string",
       "enum": [
        "company",
        "licensing",
        "estimate",
        "privacy-consent",
        "partners",
        "consulting",
        "lab",
        "contact"
       ]
      },
