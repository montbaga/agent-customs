   {
    "name": "check_program_fit",
    "title": "Check program fit",
    "description": "Runs the same matching rules as emergenttechnologies.ai/fit on a person's answers and says which kind of program fits (data licensing, the referral partner program, or expert work) and why. It collects and saves nothing and takes no personal details. To see their specific route and proceed, the person continues at /fit, where they enter their own details with consent.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "path": {
       "type": "string",
       "enum": [
        "company",
        "closed",
        "professional",
        "partner"
       ],
       "description": "company = owns or runs a company; closed = the company closed; professional = lawyer, doctor, accountant, exec; partner = brings deals"
      },
      "interest": {
       "description": "Company paths: license = license the records; refer = offer this to clients; both",
       "type": "string",
       "enum": [
        "license",
        "refer",
        "both"
       ]
      },
      "status": {
       "description": "Company path: is it still operating?",
       "type": "string",
       "enum": [
        "active",
        "closed"
       ]
      },
      "employees": {
       "description": "People at the company (at its peak if closed)",
       "type": "string",
       "enum": [
        "1-9",
        "10-19",
        "20-34",
        "35-75",
        "76-200",
        "200+"
       ]
      },
      "industry": {
       "description": "The company's industry: legal, accounting_finance, medical, or other for any other industry (for example, software and IT services, HVAC, manufacturing or logistics)",
       "type": "string",
       "enum": [
        "legal",
        "accounting_finance",
        "medical",
        "other"
       ]
      },
      "industryDetail": {
       "description": "When industry is other",
       "type": "string",
       "enum": [
        "construction_trades",
        "real_estate",
        "retail_ecommerce",
        "hospitality",
        "manufacturing",
        "logistics",
        "marketing_agency",
        "education",
        "insurance",
        "nonprofit",
        "ai_tech_startup",
        "engineering_architecture",
        "energy",
        "software_dev_agency",
        "game_studio",
        "media_production",
        "something_else"
       ]
      },
      "serves": {
       "description": "Who the company mostly serves",
       "type": "string",
       "enum": [
        "businesses",
        "consumers",
        "both"
       ]
      },
      "country": {
       "description": "us; ca_uk_au = Canada, UK or Australia; other",
       "type": "string",
       "enum": [
        "us",
        "ca_uk_au",
        "other"
       ]
      },
      "years": {
       "description": "Years of records: lt3, 3to5, 5to10, 10plus",
       "type": "string",
       "enum": [
        "lt3",
        "3to5",
        "5to10",
        "10plus"
       ]
      },
      "dataTypes": {
       "description": "Specialised records the company holds, such as CAD files, source code repositories or simulation and sensor logs; none if it holds none",
       "maxItems": 10,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "cad_bim",
         "3d_game",
         "code_repos",
         "simulation_sensor",
         "lab_clinical",
         "annotated_media",
         "none"
        ]
       }
      },
      "tools": {
       "description": "Systems the company uses; paper = mostly paper",
       "maxItems": 10,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "crm",
         "chat",
         "recordings",
         "email_calendar",
         "docs",
         "tickets",
         "billing",
         "paper"
        ]
       }
      },
      "language": {
       "description": "Language of most records",
       "type": "string",
       "enum": [
        "english",
        "not_english"
       ]
      },
      "role": {
       "description": "Professional path",
