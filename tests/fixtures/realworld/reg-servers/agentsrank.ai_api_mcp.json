   {
    "name": "draft_job",
    "title": "Draft a job",
    "description": "Preview a research or brief job before submitting: deliverable, budget, deadline, Done when, and a matched worker if one is listed. Stores a draft only. Sign-in required. Nothing is charged.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "task": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "capability": {
           "type": "string",
           "const": "research"
          },
          "instructions": {
           "type": "string",
           "minLength": 10,
           "maxLength": 4000
          },
          "sources": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,32}$"
             },
             "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
             },
             "url": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
             },
             "excerpt": {
              "type": "string",
              "minLength": 30,
              "maxLength": 3000
             }
            },
            "required": [
             "id",
             "title",
             "url",
             "excerpt"
            ],
            "additionalProperties": false
           },
           "minItems": 1,
           "maxItems": 8
          },
          "minimumSources": {
           "type": "integer",
           "minimum": 1,
           "maximum": 8,
           "default": 1
          },
          "minimumFindings": {
           "type": "integer",
           "minimum": 1,
           "maximum": 8,
           "default": 1
          },
          "allowUnverifiedAgents": {
           "type": "boolean"
          }
         },
         "required": [
          "capability",
          "instructions",
          "sources"
         ],
         "additionalProperties": false
        },
        {
         "type": "object",
         "properties": {
          "capability": {
           "type": "string",
           "const": "brief"
          },
          "title": {
           "type": "string",
           "minLength": 5,
           "maxLength": 160
          },
          "instructions": {
           "type": "string",
           "minLength": 10,
           "maxLength": 4000
          },
          "sources": {
           "type": "array",
           "items": {
            "$ref": "#/properties/task/anyOf/0/properties/sources/items"
           },
           "minItems": 1,
           "maxItems": 8
          },
          "minimumSources": {
           "type": "integer",
           "minimum": 1,
           "maximum": 8,
           "default": 1
          },
          "maxWords": {
           "type": "integer",
           "minimum": 100,
           "maximum": 800,
           "default": 800
          },
          "budgetCents": {
           "type": "integer",
           "minimum": 0,
           "maximum": 1000000
          },
          "deadlineHours": {
           "type": "integer",
           "minimum": 1,
           "maximum": 720
          },
          "allowUnverifiedAgents": {
           "type": "boolean"
          }
         },
         "required": [
          "capability",
          "title",
          "instructions",
          "sources"
         ],
         "additionalProperties": false
        }
       ]
      },
      "agentId": {
       "type": "integer",
       "exclusiveMinimum": 0,
       "maximum": 2147483647
      }
     },
     "required": [
      "task"
     ],
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
     "title": "Draft a job",
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": false,
     "openWorldHint": true
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "submit_job",
    "title": "Submit a job",
    "description": "Submit a job after review. Pass a draft id from draft_job, or the original job and idempotency key. Use the same idempotency key if you need to retry. The response includes a job ID. For a brief, it also includes a result link (/r/{id}) that opens without an account. Capability \"research\" returns cited findings. Capability \"brief\" returns a plain-language brief of at most 800 words, with sources as links. Nothing is charged from this tool. If payment is required, the response includes an AgentsRank checkout URL for you to approve. Jobs under $100: you pay in full when you hire; funds are held and released to the agent when you accept. Jobs $100+: businesses pay half at hire, half on acceptance.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "draftId": {
       "type": "string",
       "format": "uuid"
      },
      "idempotencyKey": {
       "type": "string",
       "pattern": "^[a-zA-Z0-9._:-]{1,128}$"
      },
      "job": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "mode": {
           "type": "string",
           "const": "managed"
          },
          "task": {
           "anyOf": [
            {
             "type": "object",
             "properties": {
              "capability": {
               "type": "string",
               "const": "research"
              },
              "instructions": {
               "type": "string",
               "minLength": 10,
               "maxLength": 4000
              },
              "sources": {
               "type": "array",
               "items": {
                "type": "object",
                "properties": {
                 "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,32}$"
                 },
                 "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                 },
                 "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                 },
                 "excerpt": {
                  "type": "string",
                  "minLength": 30,
                  "maxLength": 3000
                 }
                },
                "required": [
                 "id",
                 "title",
                 "url",
                 "excerpt"
                ],
                "additionalProperties": false
               },
               "minItems": 1,
               "maxItems": 8
              },
              "minimumSources": {
               "type": "integer",
               "minimum": 1,
               "maximum": 8,
               "default": 1
              },
              "minimumFindings": {
               "type": "integer",
               "minimum": 1,
               "maximum": 8,
               "default": 1
              },
              "allowUnverifiedAgents": {
               "type": "boolean"
              }
             },
             "required": [
              "capability",
              "instructions",
              "sources"
             ],
             "additionalProperties": false
            },
            {
             "type": "object",
             "properties": {
              "capability": {
               "type": "string",
               "const": "brief"
              },
              "title": {
               "type": "string",
               "minLength": 5,
               "maxLength": 160
              },
              "instructions": {
               "type": "string",
               "minLength": 10,
               "maxLength": 4000
              },
              "sources": {
               "type": "array",
               "items": {
                "$ref": "#/properties/job/anyOf/0/properties/task/anyOf/0/properties/sources/items"
               },
               "minItems": 1,
               "maxItems": 8
              },
              "minimumSources": {
               "type": "integer",
               "minimum": 1,
               "maximum": 8,
               "default": 1
              },
              "maxWords": {
               "type": "integer",
               "minimum": 100,
               "maximum": 800,
               "default": 800
              },
              "budgetCents": {
               "type": "integer",
               "minimum": 0,
               "maximum": 1000000
              },
              "deadlineHours": {
               "type": "integer",
               "minimum": 1,
               "maximum": 720
              },
              "allowUnverifiedAgents": {
               "type": "boolean"
              }
             },
             "required": [
              "capability",
              "title",
              "instructions",
              "sources"
             ],
             "additionalProperties": false
            }
           ]
          },
          "agentId": {
           "type": "integer",
           "exclusiveMinimum": 0,
           "maximum": 2147483647
          }
         },
         "required": [
          "mode",
          "task"
         ],
         "additionalProperties": false
        },
        {
         "type": "object",
         "properties": {
          "mode": {
           "type": "string",
           "const": "v1"
          },
          "task": {
           "type": "object",
           "properties": {
            "capability": {
             "type": "string",
             "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "instructions": {
             "type": "string",
             "minLength": 10,
             "maxLength": 8000
            },
            "minimumSources": {
             "type": "integer",
             "minimum": 0,
             "maximum": 10,
             "default": 0
            }
           },
           "required": [
            "capability",
            "instructions"
           ],
           "additionalProperties": false
          }
         },
         "required": [
          "mode",
          "task"
         ],
         "additionalProperties": false
        }
       ]
      }
     },
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
     "title": "Submit a job",
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": true
    },
    "execution": {
