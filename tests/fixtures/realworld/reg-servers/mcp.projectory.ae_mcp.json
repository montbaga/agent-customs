           }
          ]
         },
         "areas": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "slug": {
             "type": "string"
            },
            "name": {
             "type": "string"
            },
            "emirate": {
             "type": "string"
            }
           },
           "required": [
            "slug",
