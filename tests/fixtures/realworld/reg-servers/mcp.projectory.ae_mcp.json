   {
    "name": "fetch",
    "title": "Fetch Projectory Project",
    "description": "Fetch one development's detail using a known ID, slug or Projectory URL; no prior search or facet lookup is needed. Returns development-wide pricing, location, availability, enquiry action, payment plan, grouped unit types, evidence, media and a plain-text description marked as untrusted source material. Individual unit rows and raw HTML are omitted.\n\nAccepted forms: `project:jacob-co-beachfront-living`, `jacob-co-beachfront-living`, or `https://projectory.ae/projects/jacob-co-beachfront-living/`. Use `search` if only the project name is known.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1,
       "maxLength": 512,
       "description": "Project ID from search, plain slug, or public Projectory project URL."
      }
     },
     "required": [
      "id"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": true
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "id": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "developer": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "slug": {
           "type": "string"
          },
          "name": {
           "type": "string"
          }
         },
         "required": [
          "slug",
          "name"
         ],
         "additionalProperties": {}
        },
        {
         "type": "null"
        }
       ]
      },
      "emirate": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "slug": {
           "type": "string"
          },
          "name": {
           "type": "string"
          }
         },
         "required": [
          "slug",
          "name"
         ],
         "additionalProperties": {}
        },
        {
         "type": "null"
        }
