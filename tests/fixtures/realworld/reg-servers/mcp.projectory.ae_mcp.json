   {
    "name": "search_transactions",
    "title": "Search Projectory Transactions",
    "description": "Search canonical residential sale registrations in one required market: Dubai or Abu Dhabi. Whole area, project and building names ignore ASCII letter case; provider IDs match exactly. Filters combine with AND; date bounds are inclusive. Returns newest-first pages of 25 rows by default, at most 100. Follow `nextCursor` with the same filters only when more rows are needed for the user's task. A page's row count is not the total number of matching sales.\n\nA bedroom count matches the canonical range; 0 means studio. `sourceProjectId` is a provider identifier, not a Projectory development ID. Partial-name discovery, totals and statistics are not provided. Results do not guarantee real-time freshness.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "market": {
       "type": "string",
       "enum": [
        "dubai",
        "abu-dhabi"
       ],
       "description": "Required transaction market."
      },
      "areaName": {
       "description": "Whole canonical area name; ASCII letter case is ignored.",
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      },
      "projectName": {
       "description": "Whole canonical project name; ASCII letter case is ignored.",
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      },
      "buildingName": {
       "description": "Whole canonical building name; ASCII letter case is ignored.",
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      },
      "sourceProjectId": {
       "description": "Exact provider project identifier. This is not a Projectory development ID.",
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      },
      "from": {
       "description": "Inclusive sale-registration date lower bound in YYYY-MM-DD format; year 1900 to 2200.",
       "type": "string",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
      },
      "to": {
       "description": "Inclusive sale-registration date upper bound in YYYY-MM-DD format; year 1900 to 2200.",
       "type": "string",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
      },
      "bedrooms": {
       "description": "Bedroom count to match against each transaction's canonical bedroom range. Use 0 for a studio.",
       "type": "integer",
       "minimum": 0,
       "maximum": 20
      },
      "limit": {
       "description": "Maximum rows to return. Defaults to 25.",
       "type": "integer",
       "minimum": 1,
       "maximum": 100
      },
      "cursor": {
       "description": "Opaque pagination cursor returned by the previous transaction search page. Reuse the same filters when continuing.",
       "type": "string",
       "minLength": 1,
       "maxLength": 2048
      }
     },
     "required": [
      "market"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": true
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "transactions": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "transactionId": {
          "type": "string"
         },
         "market": {
          "type": "string",
          "enum": [
           "dubai",
           "abu-dhabi"
          ]
         },
         "saleDate": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
         },
         "sourceProjectId": {
          "type": [
           "string",
           "null"
          ]
         },
         "areaName": {
          "type": [
           "string",
           "null"
          ]
         },
         "localityName": {
          "type": [
           "string",
           "null"
          ]
         },
         "projectName": {
          "type": [
           "string",
           "null"
          ]
         },
         "buildingName": {
          "type": [
           "string",
           "null"
          ]
         },
         "propertyType": {
          "type": "string",
          "enum": [
           "apartment",
           "duplex",
           "penthouse",
           "villa",
           "townhouse",
           "land",
           "residential-complex"
          ]
         },
         "status": {
          "type": "string",
          "enum": [
           "off-plan",
           "ready"
          ]
         },
         "offPlanSaleType": {
          "anyOf": [
           {
            "type": "string",
            "enum": [
             "initial",
             "resale"
            ]
           },
           {
            "type": "null"
           }
          ]
         },
         "bedroomsMin": {
          "anyOf": [
           {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
           },
           {
            "type": "null"
           }
          ]
         },
         "bedroomsMax": {
          "anyOf": [
           {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
           },
           {
            "type": "null"
           }
          ]
         },
         "displayAreaSqft": {
          "type": [
           "number",
           "null"
          ]
         },
         "plotSizeSqft": {
          "type": [
           "number",
           "null"
          ]
         },
         "priceAed": {
          "type": "number"
         }
        },
        "required": [
         "transactionId",
         "market",
         "saleDate",
         "sourceProjectId",
         "areaName",
         "localityName",
         "projectName",
         "buildingName",
         "propertyType",
         "status",
         "offPlanSaleType",
         "bedroomsMin",
         "bedroomsMax",
         "displayAreaSqft",
         "plotSizeSqft",
         "priceAed"
        ],
        "additionalProperties": false
       }
      },
      "nextCursor": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 2048
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "transactions",
      "nextCursor"
     ],
     "additionalProperties": false
    }
   },
   {
    "name": "list_research_reports",
    "title": "List Projectory Research Reports",
    "description": "List citable Projectory Research reports, newest first. Reports analyse registered residential sales from Dubai Land Department (DLD) and Abu Dhabi Real Estate Centre (ADREC) transaction records. Each report has a canonical `url` to cite and usually a downloadable `dataset` with its citation, temporal coverage and licence.\n\n`market` dubai returns DLD-based reports and abu-dhabi returns ADREC-based reports; combined reports match both. Returns 10 reports by default, at most 50; there is no pagination. Reports are informational, not financial or investment advice.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "market": {
       "description": "Return reports covering this market.",
       "type": "string",
       "enum": [
        "dubai",
        "abu-dhabi"
       ]
      },
      "period": {
       "description": "Return reports covering this reporting period.",
       "type": "string",
       "enum": [
        "weekly",
        "monthly",
        "quarterly",
        "half-year",
        "annual"
       ]
      },
      "limit": {
       "description": "Maximum reports to return. Defaults to 10.",
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      }
     },
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": true
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
