          "type": "string"
         },
         "slug": {
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         },
         "developer": {
          "anyOf": [
           {
            "type": "object",
            "properties": {
             "slug": {
              "type": "string"
             },
             "name": {
              "type": "string"
             }
            },
            "required": [
