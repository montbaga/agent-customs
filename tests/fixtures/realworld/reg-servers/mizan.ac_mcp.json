      "query": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200,
       "description": "A player id, profile link or name, as typed into mizan.ac/lookup."
      }
     },
     "required": [
      "query"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true
    },
