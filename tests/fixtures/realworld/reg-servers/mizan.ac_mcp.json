   {
    "name": "list_sources",
    "title": "List the ban lists Mizan reads",
    "description": "List the ban lists Mizan reads, largest first: each list's name, who issues its bans, the games it covers, its bans and how many are in force, and whether Mizan is still reading it. Filter by game key or by part of the name.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "game": {
       "description": "A game key, such as rust, garrysmod, cs2, csgo, tf2 or squad; registry_stats lists every one.",
       "type": "string",
       "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "name": {
       "description": "Part of a list's name, such as \"sourcebans\".",
       "type": "string",
       "minLength": 1,
       "maxLength": 64
      },
      "limit": {
       "description": "Lists to return, largest first. Defaults to 25.",
       "type": "integer",
       "minimum": 1,
       "maximum": 100
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "ok": {
       "type": "boolean",
       "const": true
      },
      "lists": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991,
       "description": "Every list Mizan reads."
      },
      "matched": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991,
       "description": "Lists matching the filters, before the limit."
      },
      "readAt": {
       "type": "string",
       "description": "ISO 8601 time"
      },
      "sources": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "key": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "kind": {
          "description": "Who issues the list's bans: anti_cheat, staff, platform, community",
          "type": [
           "string",
           "null"
          ]
         },
         "games": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "bans": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
         },
         "inForce": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
         },
         "state": {
          "type": "string",
          "enum": [
           "reading",
           "retrying",
           "stopped"
          ]
         },
         "site": {
          "type": [
           "string",
           "null"
          ]
         },
         "page": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "key",
         "name",
         "kind",
         "games",
         "bans",
         "inForce",
         "state",
         "site",
         "page"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "ok",
      "lists",
      "matched",
      "readAt",
      "sources"
     ],
     "additionalProperties": false
    }
   },
