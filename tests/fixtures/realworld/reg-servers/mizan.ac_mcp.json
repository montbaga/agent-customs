       "maximum": 9007199254740991,
       "description": "The record format's version; it changes only when a field changes meaning or goes away."
      },
      "player": {
       "type": "object",
       "properties": {
        "provider": {
         "type": "string",
         "description": "steam, discord, minecraft, fivem, epic, xbox or eos"
        },
        "id": {
         "type": "string"
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        },
        "ids": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "label": {
            "type": "string"
           },
           "value": {
            "type": "string"
           }
          },
          "required": [
           "label",
           "value"
          ],
          "additionalProperties": false
         },
         "description": "The same account in every id form, such as SteamID and SteamID3."
        }
       },
       "required": [
