       "properties": {
        "label": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "label",
        "url"
       ],
       "additionalProperties": false
      },
      "terms_url": {
       "type": "string"
      },
      "privacy_url": {
       "type": "string"
      },
      "errors": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "suggestions": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "status"
     ],
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    }
   }
  ]
 }
