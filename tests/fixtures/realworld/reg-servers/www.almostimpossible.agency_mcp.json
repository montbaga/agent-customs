   {
    "name": "list_work",
    "title": "List case studies",
    "description": "Published case studies in the agency's own order, 1 to 20 per page, each with client, year and summary. The optional query filters by title, client or summary (e.g. \"Mashreq\"). Use get_work with a slug for one case study's services and summary.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "maxLength": 100,
       "description": "Words to match against the title, client or summary."
      },
      "offset": {
       "type": "integer",
       "minimum": 0,
       "default": 0,
       "description": "How many matching case studies to skip, for paging (0 for the first page)."
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 20,
       "default": 10,
       "description": "How many case studies to return, from 1 to 20."
      },
      "cursor": {
       "type": "string",
       "maxLength": 100,
       "description": "next_cursor from the previous page; takes precedence over offset."
      }
     },
     "required": [],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "total": {
       "type": "integer"
      },
      "offset": {
       "type": "integer"
      },
      "limit": {
       "type": "integer"
      },
      "next_cursor": {
       "type": [
        "string",
        "null"
       ]
      },
      "items": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "slug": {
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "client": {
          "type": [
           "string",
           "null"
          ]
         },
         "year": {
          "type": [
           "integer",
           "null"
          ]
         },
         "summary": {
          "type": [
           "string",
           "null"
          ]
         },
         "url": {
          "type": "string",
          "format": "uri"
         }
        },
        "required": [
         "slug",
         "title",
         "client",
         "year",
         "summary",
         "url"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "total",
      "offset",
      "limit",
      "next_cursor",
      "items"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "title": "List case studies",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
