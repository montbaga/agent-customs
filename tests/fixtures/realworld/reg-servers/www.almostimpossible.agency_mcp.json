       "type": "string"
      },
      "legalName": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "foundingDate": {
       "type": "string"
      },
      "services": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "awards": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "url": {
       "type": "string",
       "format": "uri"
      },
      "contact": {
       "type": "string",
       "format": "uri"
      }
     },
     "required": [
