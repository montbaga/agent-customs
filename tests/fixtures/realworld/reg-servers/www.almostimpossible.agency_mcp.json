{
 "url": "https://www.almostimpossible.agency/mcp",
 "doc": {
  "name": "Almost Impossible",
  "version": "1.0.0",
  "protocolVersion": "2025-06-18",
  "instructions": "Almost Impossible is an independent creative agency in Dubai (brand strategy, digital, experiential). This server reads its public website; every tool is read-only and needs no sign-in. Start with search_site for open questions, get_agency_overview for facts about the agency, list_work then get_work for case studies, and list_team for people. Use get_page to read any page in full as Markdown before quoting it, and cite the page URL. Prices are scoped per brief and not published. To start a project, send the person to https://www.almostimpossible.agency/#contact; this server cannot send enquiries.",
  "tools": [
   {
    "name": "search_site",
    "title": "Search the website",
    "description": "Keyword search across the whole Almost Impossible website: pages, case studies, news and journal articles. Start here for any open question (\"experiential work for banks\", \"pricing\", \"awards\"). Returns up to 10 matches with URL and summary; read one in full with get_page.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "maxLength": 200,
       "description": "What to look for, in a few words."
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 10,
       "default": 10,
       "description": "How many matches to return, from 1 to 10."
      }
     },
     "required": [
      "query"
     ],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string"
      },
      "results": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "@type": {
          "type": "string",
          "description": "schema.org type: WebPage, CreativeWork (case study), NewsArticle or Article."
         },
         "name": {
          "type": "string"
         },
         "url": {
          "type": "string",
          "format": "uri"
         },
         "description": {
          "type": "string"
         }
        },
        "required": [
         "@type",
         "name",
         "url",
         "description"
        ]
       }
      }
     },
     "required": [
      "query",
      "results"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "title": "Search the website",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "get_page",
    "title": "Read a page as Markdown",
    "description": "The full text of one public page as Markdown, by its path: \"/\" (home), \"/about\", \"/process\", \"/faq\", \"/awards\", \"/work/<slug>\", \"/news/<slug>\" and so on. Use it after search_site or list_work to read and cite the page itself.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "path": {
       "type": "string",
       "maxLength": 300,
       "description": "The page path, starting with \"/\", e.g. \"/about\" or \"/work/<slug>\"."
      }
     },
     "required": [
      "path"
     ],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
      "path": {
       "type": "string"
      },
      "url": {
       "type": "string",
       "format": "uri"
      },
      "markdown": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "url",
      "markdown"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "title": "Read a page as Markdown",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "get_agency_overview",
    "title": "Agency overview",
    "description": "Fixed facts about Almost Impossible, the independent creative agency in Dubai: legal name, founding date, founder, address, areas served, the three service lines and agency awards. Use it to describe, compare or verify the agency.",
    "inputSchema": {
     "type": "object",
     "properties": {},
     "required": [],
     "additionalProperties": false
    },
    "outputSchema": {
     "type": "object",
     "properties": {
