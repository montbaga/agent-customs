{
 "url": "https://agentsgetpaidmore.com/mcp",
 "doc": {
  "name": "wren-unlock-mcp",
  "version": "0.1.2",
  "protocolVersion": "2025-06-18",
  "tools": [
   {
    "name": "get_quote",
    "description": "Free quote, then buy_kit: 49 USDC on Base x402. Humans #pay. Caps + AUP. Not auto-income. SPIRAL $0.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "kind": {
       "type": "string",
       "description": "Optional captcha kind: v2, turnstile, hard, unlock.page, image"
      }
     },
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    }
   },
   {
    "name": "get_spend_status",
    "description": "Show in-memory spend / rate usage for this isolate (MVP). Free.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "tenantId": {
       "type": "string",
       "description": "Optional tenant key; default 'default'"
      }
     },
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    }
   },
   {
    "name": "report_issue",
    "description": "Report a product or policy issue (logged server-side). Free.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "summary": {
       "type": "string",
       "minLength": 3,
       "maxLength": 500
      },
      "detail": {
       "type": "string",
       "maxLength": 4000
      },
      "toolName": {
       "type": "string"
      }
     },
     "required": [
      "summary"
     ],
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    }
   },
   {
    "name": "solve_captcha",
    "description": "Paid x402 USDC CAPTCHA solve for agents mid-task. Spend caps + AUP. Allowlisted purposes only; refuses login/signup/payment abuse.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "kind": {
       "type": "string",
       "enum": [
        "v2",
        "v3",
        "turnstile",
        "hard",
        "image"
       ],
       "description": "CAPTCHA family"
      },
      "websiteURL": {
       "type": "string",
       "format": "uri"
      },
      "websiteKey": {
       "type": "string"
      },
      "imageBase64": {
       "type": "string"
      },
      "pageAction": {
       "type": "string",
       "description": "Optional reCAPTCHA v3 action"
      },
      "purpose": {
       "type": "string",
       "description": "Must be one of: research_scrape, accessibility, qa_testing, content_indexing, monitoring, other_legitimate"
      },
      "tenantId": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "websiteURL",
      "purpose"
     ],
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {},
    "_meta": {
     "agents-x402/paymentRequired": true,
     "agents-x402/priceUSD": 0.008
    }
   },
   {
    "name": "unlock_page",
    "description": "Paid x402 USDC web-unlock for agents. Fetch pages for legitimate research/indexing. Spend caps + AUP. HTTP 402 payment-required MCP.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string",
       "format": "uri"
      },
      "purpose": {
       "type": "string",
       "description": "Must be one of: research_scrape, accessibility, qa_testing, content_indexing, monitoring, other_legitimate"
      },
      "tenantId": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "purpose"
     ],
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {},
    "_meta": {
     "agents-x402/paymentRequired": true,
     "agents-x402/priceUSD": 0.006
    }
   },
   {
    "name": "buy_kit",
    "description": "Pay 49 USDC on Base for the Agents Get Paid Kit. Same price as https://agentsgetpaidmore.com/#pay. Not auto-income. SPIRAL / in-fleet = $0 (do not charge).",
    "inputSchema": {
     "type": "object",
     "properties": {
      "agentName": {
       "type": "string",
       "description": "Buyer agent name for the receipt"
      },
      "tenantId": {
       "type": "string"
      },
      "quoteId": {
       "type": "string",
       "description": "Opaque quote handle from get_quote. No PII."
      },
      "note": {
       "type": "string"
      }
     },
     "additionalProperties": false,
     "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {},
    "_meta": {
     "agents-x402/paymentRequired": true,
     "agents-x402/priceUSD": 49
    }
   }
  ]
 }
}