   {
    "name": "prepare_appointment_request",
    "title": "Prepare an LVOS staff follow-up request",
    "description": "Validates a staff follow-up request for LVOS: first and last name, one contact method (phone or email), consultation type and an optional scheduling preference. Returns the normalized details, a disclosure of how they will be stored and emailed, an idempotency key and a confirmation token valid for 15 minutes. Stores nothing and sends nothing. Has no fields for date of birth, insurance, payment details or medical history.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "practice_id": {
       "type": "string",
       "const": "LVOS",
       "description": "Always LVOS (Larchmont Village Oral Surgery)."
      },
      "first_name": {
       "type": "string",
       "minLength": 1,
       "maxLength": 80,
       "description": "Patient first name, for example Maria."
      },
      "last_name": {
       "type": "string",
       "minLength": 1,
       "maxLength": 80,
       "description": "Patient last name, for example Lopez."
      },
      "contact": {
       "oneOf": [
        {
         "type": "object",
         "properties": {
          "method": {
           "type": "string",
           "const": "phone"
          },
          "value": {
           "type": "string",
           "minLength": 8,
           "maxLength": 32,
           "pattern": "^\\+?[0-9 ().\\-]+$",
           "description": "Callback number: a US number such as (323) 555-0100, or an international number beginning with +."
          }
         },
         "required": [
          "method",
          "value"
         ],
         "additionalProperties": false
        },
        {
         "type": "object",
         "properties": {
          "method": {
           "type": "string",
           "const": "email"
          },
          "value": {
           "type": "string",
           "minLength": 3,
           "maxLength": 254,
           "format": "email",
           "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
           "description": "Email address for staff follow-up, for example maria@example.com."
          }
         },
         "required": [
          "method",
          "value"
         ],
         "additionalProperties": false
        }
       ],
       "description": "Exactly one way for staff to reach the patient."
      },
      "appointment_type": {
       "type": "string",
       "enum": [
        "consult",
        "surgery_consult"
       ],
       "description": "consult: the practice's 'Consult' type (about 30 minutes). surgery_consult: its 'Surgery Consult' type (about 60 minutes). Staff confirm the right type."
      },
      "preferred_day_or_time": {
       "description": "Optional scheduling preference, for example 'weekday mornings'. Not an available or reserved slot. No clinical details.",
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      }
     },
     "required": [
      "practice_id",
      "first_name",
      "last_name",
      "contact",
      "appointment_type"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "title": "Prepare an LVOS staff follow-up request",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": false,
     "openWorldHint": false
    },
    "_meta": {
     "openai/toolInvocation/invoking": "Preparing request for review",
     "openai/toolInvocation/invoked": "Request ready for your review"
    },
