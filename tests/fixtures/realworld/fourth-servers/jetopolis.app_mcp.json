       "minimum": -9007199254740991,
       "maximum": 9007199254740991
      },
      "total": {
       "type": "integer",
       "minimum": -9007199254740991,
       "maximum": 9007199254740991
      },
      "airlines": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "code": {
          "type": [
           "string",
           "null"
          ]
         },
         "country": {
          "type": "string"
         },
         "region": {
          "type": "string",
