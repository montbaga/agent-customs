   {
    "name": "list_worlds",
    "title": "Live worlds",
    "description": "Public Jetopolis worlds open right now: name, server region, pace (Standard: 1 game day = 20 real minutes, Blitz: 5), start and end year, current game date and era, players and seats, players active in the last 24 hours, and a link to open the world. Worlds never pause.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "status": {
       "type": "string",
       "enum": [
        "RUNNING",
        "FINALE",
        "FINISHED"
       ]
      },
      "type": {
       "description": "STANDARD: 1 game day = 20 min, BLITZ: 5 min",
       "type": "string",
       "enum": [
        "BLITZ",
        "STANDARD",
        "ENDLESS",
        "PRIVATE"
       ]
      },
      "region": {
       "description": "Server region of the world",
       "type": "string",
       "enum": [
        "wnam",
        "enam",
        "weur",
        "eeur",
        "apac-ne",
        "apac-se",
        "oc"
       ]
      },
      "lang": {
       "description": "Language for the human-readable labels next to keys, one of the 25 game locales (en, ru, de, fr, es, ja, zh-CN and others); unknown values fall back to English",
       "type": "string",
       "maxLength": 10
      }
     }
    },
