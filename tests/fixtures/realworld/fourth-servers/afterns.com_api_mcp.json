{
 "url": "https://afterns.com/api/mcp",
 "doc": {
  "name": "afterns",
  "version": "0.47.0",
  "protocolVersion": "2025-06-18",
  "tools": [
   {
    "name": "search_stocks",
    "title": "Find a US stock",
    "description": "Find US-listed stocks by ticker or company name, including Korean names and nicknames (e.g. 구글 → GOOGL, 엔비디아 → NVDA). Use when the user names a company and you need its ticker.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "query": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40,
       "description": "Ticker or company name to look up, in Korean or English (구글, Alphabet, GOOGL)"
      },
      "lang": {
       "default": "ko",
       "description": "Answer language. Use \"ko\" when the user writes in Korean, otherwise \"en\".",
       "type": "string",
       "enum": [
        "ko",
        "en"
       ]
      }
     },
     "required": [
      "query"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false,
     "title": "Find a US stock"
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "results": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "ticker": {
          "type": "string"
         },
         "name_ko": {
          "type": "string"
         },
         "name_en": {
          "type": "string"
         },
         "sector": {
          "type": "string"
         },
         "url": {
          "type": "string",
          "description": "afterns page for this stock"
         },
         "logo": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "ticker",
         "name_ko",
         "name_en",
         "sector",
         "url",
         "logo"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "results"
     ],
     "additionalProperties": false
    }
   },
   {
    "name": "get_earnings_reactions",
    "title": "Earnings reactions and next report date",
    "description": "Show how a US stock moved the day after each of its recent earnings reports (up to the 12 most recent), whether EPS beat or missed estimates, and its next earnings date in Korea and US Eastern time. Use for questions like \"엔비디아 실적 발표 언제야?\", \"마이크로소프트 실적 나오면 주가 어떻게 움직였어?\", \"Does Tesla usually drop after earnings?\". Historical data only; it does not predict prices. The result is shown as an interactive card with the chart, stats, and earnings-call takeaways.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "stock": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40,
       "description": "Ticker (NVDA) or company name in Korean or English (엔비디아, Nvidia, 구글)"
      },
      "lang": {
       "default": "ko",
       "description": "Answer language. Use \"ko\" when the user writes in Korean, otherwise \"en\".",
       "type": "string",
       "enum": [
        "ko",
        "en"
       ]
      },
      "limit": {
       "default": 12,
       "description": "How many of the most recent reports to return (1-12)",
       "type": "integer",
       "minimum": 1,
       "maximum": 12
      }
     },
     "required": [
      "stock"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false,
     "title": "Earnings reactions and next report date"
    },
    "_meta": {
     "ui": {
      "resourceUri": "ui://afterns/reactions-834925a6.html"
     },
     "openai/outputTemplate": "ui://afterns/reactions-834925a6.html"
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "lang": {
       "type": "string",
       "enum": [
        "ko",
        "en"
       ]
      },
      "stock": {
       "type": "object",
       "properties": {
        "ticker": {
         "type": "string"
        },
        "name_ko": {
         "type": "string"
        },
        "name_en": {
         "type": "string"
        },
        "sector": {
         "type": "string"
        },
        "url": {
         "type": "string",
         "description": "afterns page for this stock"
        },
        "logo": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "ticker",
        "name_ko",
        "name_en",
        "sector",
        "url",
        "logo"
       ],
       "additionalProperties": false
      },
      "next": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "date_et": {
           "type": "string",
           "description": "US Eastern date YYYY-MM-DD"
          },
          "session": {
           "anyOf": [
            {
             "type": "string",
             "enum": [
              "before_open",
              "after_close"
             ]
            },
            {
             "type": "null"
            }
           ]
          },
          "time_kst": {
           "description": "Korea time, only when the source gives a time",
           "type": [
            "string",
            "null"
           ]
          },
          "time_et": {
           "type": [
            "string",
            "null"
           ]
          },
          "status": {
           "type": "string",
           "enum": [
            "confirmed",
            "unconfirmed",
            "estimated"
           ],
           "description": "estimated = projected from past cadence, not announced"
          }
         },
         "required": [
          "date_et",
          "session",
          "time_kst",
          "time_et",
          "status"
         ],
         "additionalProperties": false
        },
        {
         "type": "null"
        }
       ]
