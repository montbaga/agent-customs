              "miss",
              "inline"
             ]
            },
            {
             "type": "null"
            }
           ]
          },
          "eps_surprise_pct": {
           "type": [
            "number",
            "null"
           ]
          },
          "revenue_usd": {
           "type": [
            "number",
            "null"
           ]
          },
          "revenue_display": {
           "type": [
            "string",
            "null"
           ]
          },
          "revenue_yoy_pct": {
           "type": [
            "number",
            "null"
           ]
          },
          "guidance_revenue_usd": {
           "description": "company's revenue guidance for the next quarter, when given",
           "type": [
            "number",
            "null"
           ]
          },
          "guidance_display": {
           "type": [
            "string",
            "null"
           ]
          }
         },
         "required": [
          "announced",
          "period_end",
          "eps",
          "eps_currency",
          "eps_display",
          "eps_estimate",
          "eps_estimate_display",
          "eps_vs_estimate",
          "eps_surprise_pct",
          "revenue_usd",
          "revenue_display",
