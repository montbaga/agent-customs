         "eps_surprise_pct": {
          "type": [
           "number",
           "null"
          ]
         },
         "revenue_yoy_pct": {
          "type": [
           "number",
           "null"
          ]
         }
        },
        "required": [
         "announced",
         "session",
         "period_end",
         "next_day_pct",
         "eps_vs_estimate",
         "eps_surprise_pct",
         "revenue_yoy_pct"
        ],
        "additionalProperties": false
       }
      },
      "latest": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "announced": {
           "type": "string"
          },
          "period_end": {
           "type": "string"
          },
          "eps": {
           "description": "adjusted EPS when the company reports one, else GAAP; currency in eps_currency",
           "type": [
