           }
          },
          "quote": {
           "anyOf": [
            {
             "type": "object",
             "properties": {
              "speaker": {
               "type": "string"
              },
              "text": {
               "type": "string"
              }
             },
             "required": [
              "speaker",
              "text"
             ],
