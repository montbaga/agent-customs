{
 "url": "https://catalantable.app/mcp",
 "doc": {
  "name": "catalan-table-recipes",
  "version": "1.0.0",
  "protocolVersion": "2025-06-18",
  "instructions": "The Catalan Table: traditional Catalan and Spanish recipes. 470+ tested recipes with ingredients, step-by-step instructions, and nutrition, in English, Spanish, and Catalan. Use `search` to find recipes, then `fetch` with a result id for the full recipe. `get_recipe` returns the same recipe as structured JSON; `list_categories` lists categories. Cite the recipe url when presenting a recipe.",
  "tools": [
   {
    "name": "search",
    "title": "Search Catalan and Spanish recipes",
    "description": "Use this when the user wants Catalan, Spanish, or Mediterranean recipes or cooking ideas: dishes, desserts, breads, sauces, preserves, drinks, or techniques. Searches 470+ tested recipes by dish name, ingredient, or tag, in English, Spanish, or Catalan. Returns up to 10 results; call `fetch` with a result id for the full recipe.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "query": {
       "type": "string"
      }
     },
     "required": [
      "query"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "results": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "title",
         "url"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "results"
     ],
     "additionalProperties": false
    }
   },
   {
    "name": "fetch",
    "title": "Fetch a full recipe",
    "description": "Use this to retrieve the complete recipe (ingredients with quantities, steps, tips, nutrition) for an id returned by `search`.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "metadata": {
       "type": "object",
       "properties": {
        "locale": {
         "type": "string",
         "enum": [
          "en",
          "es",
          "ca"
         ]
        },
        "contentType": {
         "type": "string"
        },
        "category": {
         "type": [
          "string",
          "null"
         ]
        },
        "tags": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "date": {
         "type": "string"
        }
       },
       "required": [
        "locale",
        "contentType",
        "category",
        "tags",
        "date"
       ],
       "additionalProperties": false
      }
     },
     "required": [
      "id",
      "title",
      "text",
      "url",
      "metadata"
     ],
     "additionalProperties": false
    }
   },
   {
    "name": "list_categories",
    "title": "List recipe categories",
    "description": "Use this to browse the recipe categories (main dishes, soups, desserts, breads, sauces and preserves, drinks...) with recipe counts, before searching.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "locale": {
       "type": "string",
       "enum": [
        "en",
        "es",
        "ca"
       ]
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "categories": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "key": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "count": {
          "type": "number"
         }
        },
        "required": [
         "key",
         "name",
         "count"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "categories"
     ],
     "additionalProperties": false
    }
   },
   {
    "name": "get_recipe",
    "title": "Get a recipe as structured data",
    "description": "Use this when you already know a recipe's slug and want structured JSON (ingredient quantities and units, steps, servings, nutrition) instead of prose, for example to scale quantities or build a shopping list.",
    "inputSchema": {
     "type": "object",
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "slug": {
       "type": "string"
      },
      "locale": {
       "type": "string",
       "enum": [
        "en",
        "es",
        "ca"
       ]
      }
     },
     "required": [
      "slug"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "openWorldHint": false
    },
    "outputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object",
     "properties": {
      "id": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "locale": {
       "type": "string",
       "enum": [
        "en",
        "es",
        "ca"
       ]
      },
      "contentType": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "date": {
       "type": "string"
      },
      "servings": {
       "type": [
        "number",
        "null"
       ]
      },
      "yield": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "quantity": {
           "type": "number"
          },
          "quantityMax": {
           "type": [
            "number",
            "null"
           ]
          },
          "label": {
           "type": "string"
          }
         },
         "required": [
          "quantity",
          "quantityMax",
          "label"
         ],
         "additionalProperties": false
        },
        {
         "type": "null"
        }
       ]
      },
      "ingredientSections": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "name": {
          "type": "string"
         },
         "ingredients": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "quantity": {
             "type": [
              "number",
              "string",
              "null"
             ]
            },
            "quantityMax": {
             "type": [
              "number",
              "string",
              "null"
             ]
            },
            "unit": {
             "type": "string"
            },
            "name": {
             "type": "string"
            },
            "text": {
             "type": "string"
            }
           },
           "required": [
            "quantity",
            "quantityMax",
            "unit",
            "name",
            "text"
           ],
           "additionalProperties": false
          }
         }
        },
        "required": [
         "name",
         "ingredients"
        ],
        "additionalProperties": false
       }
      },
      "procedureSections": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "name": {
          "type": "string"
         },
         "description": {
          "type": [
           "string",
           "null"
          ]
         },
         "steps": {
          "type": "array",
          "items": {
           "type": "string"
          }
         }
        },
        "required": [
         "name",
         "description",
         "steps"
        ],
        "additionalProperties": false
       }
      },
      "tips": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "nutrition": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "basis": {
           "type": "string",
           "enum": [
            "per_serving",
            "per_item",
            "per_100g"
           ]
          },
          "values": {
           "type": "object",
           "properties": {
            "calories": {
             "type": "number"
            },
            "protein": {
             "type": "number"
            },
            "fat": {
             "type": "number"
            },
            "carbs": {
             "type": "number"
            }
           },
           "required": [
            "calories",
            "protein",
            "fat",
            "carbs"
           ],
           "additionalProperties": false
          },
          "per100g": {
           "type": "object",
           "properties": {
            "calories": {
             "type": "number"
            },
            "protein": {
             "type": "number"
            },
            "fat": {
             "type": "number"
            },
            "carbs": {
             "type": "number"
            }
           },
           "required": [
            "calories",
            "protein",
            "fat",
            "carbs"
           ],
           "additionalProperties": false
          },
          "source": {
           "type": "string"
          }
         },
         "required": [
          "basis",
          "values",
          "per100g",
          "source"
         ],
         "additionalProperties": false
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "url",
      "locale",
      "contentType",
      "title",
      "description",
      "category",
      "tags",
      "date",
      "servings",
      "yield",
      "ingredientSections",
      "procedureSections",
      "tips",
      "nutrition"
     ],
     "additionalProperties": false
    }
   }
  ]
 }
}