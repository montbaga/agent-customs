     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "maxLength": 2000,
       "description": "Natural language query about skin concerns (e.g. 'I have oily acne-prone skin, under $30')"
      },
      "strategy": {
       "type": "string",
       "maxLength": 50,
       "description": "Optional offer strategy override: starter, gentle, budget, glow_safe, minimal, strong, fallback"
