      },
      "issue_type": {
       "type": "string",
       "enum": [
        "wrong_products",
        "too_few_products",
        "too_expensive",
        "ignored_concern",
        "ignored_budget",
        "bad_recommendation",
        "cart_mismatch",
        "missing_product",
        "other"
       ],
       "description": "Type of issue"
