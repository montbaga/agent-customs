       "type": "string",
       "minLength": 2,
       "maxLength": 2
      },
      "quantity": {
       "default": 1,
       "type": "integer",
       "minimum": 1,
       "maximum": 10
      },
      "idempotencyKey": {
       "type": "string",
       "minLength": 8,
       "maxLength": 100,
       "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "shippingAddress": {
       "type": "object",
