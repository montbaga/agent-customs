   {
    "name": "create_book",
    "title": "Make a photo book",
    "description": "Use this when the person wants a photo book (Dutch: fotoboek) made from photos they attached, direct image links, or a public iCloud Shared Album link. Designs a draft book from the photos in the supplied order; nothing is ordered or charged. Photos the person attached in this chat go in attachments, which ChatGPT fills in; never pass local file paths. Otherwise provide direct CDN image URLs or uploadIds from POST /api/connector/photos in photos (you can choose the best photos yourself and send only those, in order; HEIC and rotated phone photos are accepted), or a public iCloud Shared Album link as sharedAlbumUrl (https://www.icloud.com/sharedalbum/#TOKEN). A book needs at least 24 pages to be printed, so a handful of photos gives a book that can be viewed but not yet ordered. Returns a preview and a private link to save the book by email. No account setup. Allow up to 180 seconds for imports.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "idempotencyKey": {
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "title": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      },
      "productId": {
       "type": "string",
       "maxLength": 100
      },
      "attachments": {
       "description": "Photos the person attached in this chat. ChatGPT supplies the file objects; never invent them.",
       "minItems": 1,
       "maxItems": 100,
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "download_url": {
          "type": "string"
         },
         "file_id": {
          "type": "string"
         },
         "mime_type": {
          "type": "string"
         },
         "file_name": {
          "type": "string"
         }
        },
        "required": [
         "download_url",
         "file_id"
        ],
        "additionalProperties": false
       }
      },
      "photos": {
       "description": "Public https image URLs on a known CDN, or uploadIds. Not for chat attachments or local paths.",
       "minItems": 1,
       "maxItems": 100,
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "url": {
          "type": "string",
          "maxLength": 4096,
          "format": "uri"
         },
         "uploadId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
         },
         "filename": {
          "default": "photo.jpg",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
         }
        }
       }
      },
      "sharedAlbumUrl": {
       "description": "Public iCloud Shared Album link, used instead of photos.",
       "type": "string",
       "maxLength": 2048,
       "format": "uri"
      },
      "language": {
       "description": "Two-letter code of the language the person writes in, such as nl or en.",
       "type": "string",
       "maxLength": 35
      }
     },
     "required": [
      "idempotencyKey",
      "title"
     ]
    },
    "annotations": {
     "title": "Make a photo book",
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": true
    },
    "execution": {
