   {
    "name": "create_payment_quote",
    "title": "Prepare a payment quote",
    "description": "Use this when you pay for the book on the person's behalf. Prepares a fixed payment quote for a printed book, including shipping, for MPP and, when listed, x402 (USDC on Base). Requires a complete delivery address, and email for the order confirmation when the book is not saved to an account yet. No charge yet. Ask the user to confirm the total and address before paying: pay_book for MPP, or POST paymentUrl with an x402 client for USDC. Quote expires after 15 minutes.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "bookId": {
       "type": "string",
