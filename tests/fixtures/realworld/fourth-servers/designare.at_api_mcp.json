    "description": "Semantische Suche in der designare.at Knowledge Base. Findet relevante Informationen über Michael Kanda, seine Web- und KI-Kompetenzfelder, Projekte, Blog-Artikel und Expertise. Nutze dieses Tool wenn du Fragen über designare.at, WordPress, SEO, GEO (Generative Engine Optimization), KI-Sichtbarkeit oder Michael Kandas Arbeit beantworten willst.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Die Suchanfrage in natürlicher Sprache (deutsch oder englisch). Beispiele: \"Womit beschäftigt sich Michael Kanda?\", \"Was ist GEO?\", \"Welche WordPress-Projekte gibt es?\""
      }
     },
     "required": [
      "query"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "title": "designare.at-Wissen durchsuchen",
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
