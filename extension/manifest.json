{
  "manifest_version": 3,
  "name": "Agent Customs Inspector",
  "version": "1.0.0",
  "description": "Inspect Open Agentic Web, Google A2A, and MCP agent endpoints directly from your browser toolbar.",
  "permissions": ["activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Inspect site with Agent Customs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
